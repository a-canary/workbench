#!/usr/bin/env bash
# pre-push-public — block pushes to public GitHub repos without a clear record.
#   git calls it:    pre-push-public <remote-name> <remote-url>
#                    (stdin: lines of "<local ref> <local sha> <remote ref> <remote sha>")
#   reviewer clears: pre-push-public --clear <owner/repo> <sha> "<summary>"
# Seams: PUSH_GUARD_VIS_CMD <owner/repo> prints PUBLIC|PRIVATE|INTERNAL (non-zero = unknown).
#        Default: gh repo view "<owner/repo>" --json visibility -q .visibility.
#        PUSH_GUARD_DIR holds clears.tsv (default ~/.local/state/push-guard).
# A clear names the tip commit of a pushed ref and covers its history; a rebase changes the tip
# and so needs a new clear. Nothing calls this file until it is wired in as a pre-push hook.
# git push --no-verify skips every git hook, so this catches mistakes, not a determined bypass.
set -uo pipefail

# ponytail: no visibility cache; one gh call per push. Add a short-lived cache for PUBLIC answers only if pushes get slow.

ZERO=0000000000000000000000000000000000000000
GUARD_DIR="${PUSH_GUARD_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/push-guard}"
CLEAR_FILE="$GUARD_DIR/clears.tsv"

usage() {
  echo "usage: pre-push-public --clear <owner/repo> <sha> \"<summary>\"" >&2
}

# --- clear mode ---
if [ "${1:-}" = "--clear" ]; then
  if [ $# -ne 4 ]; then usage; exit 2; fi
  repo="$2"
  sha="$3"
  summary="$4"
  if ! [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then usage; exit 2; fi
  if ! [[ "$sha" =~ ^[0-9a-fA-F]{40}$ ]]; then usage; exit 2; fi
  if [ -z "$summary" ]; then usage; exit 2; fi
  repo=$(tr 'A-Z' 'a-z' <<<"$repo")
  sha=$(tr 'A-Z' 'a-z' <<<"$sha")
  summary=$(printf '%s' "$summary" | tr '\t\n\r' '   ')
  mkdir -p "$GUARD_DIR"
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s\t%s\t%s\t%s\n' "$ts" "$repo" "$sha" "$summary" >> "$CLEAR_FILE"
  exit 0
fi

# --- push mode ---
if [ $# -ne 2 ]; then
  echo "pre-push-public: expected <remote-name> <remote-url>" >&2
  exit 1
fi
remote_url="$2"

# 1. Parse GitHub URL; anything else passes through
shopt -s nocasematch
owner_repo=""
if [[ "$remote_url" =~ ^git@github\.com:([^/]+)/([^/]+)$ ]]; then
  owner_repo="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
elif [[ "$remote_url" =~ ^(https?|ssh)://([^/@]+@)?github\.com/([^/]+)/([^/]+)$ ]]; then
  owner_repo="${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
fi
looks_github=0
# a GitHub url in a form not read above (port, trailing slash, git://, www.) must not slip through as "not GitHub"
[[ "$remote_url" =~ (^|[@/.])github\.com([:/]|$) ]] && looks_github=1
shopt -u nocasematch

owner_repo="${owner_repo%.git}"
if [ -z "$owner_repo" ]; then
  [ "$looks_github" -eq 0 ] && exit 0
  echo "push-guard: unknown GitHub url form; cannot tell which repo this is"
  exit 1
fi
owner_repo_lower=$(tr 'A-Z' 'a-z' <<<"$owner_repo")

# 2. Read refs; skip branch deletes (all-zero local sha)
refs=()
while IFS= read -r line || [ -n "$line" ]; do
  read -r lref lsha rref rsha <<<"$line"
  if [ "$lsha" = "$ZERO" ]; then
    continue
  fi
  refs+=("$line")
done

if [ ${#refs[@]} -eq 0 ]; then
  exit 0
fi

# 3. Visibility lookup — once per push
lookup_vis() {
  if [ -n "${PUSH_GUARD_VIS_CMD:-}" ]; then
    "$PUSH_GUARD_VIS_CMD" "$owner_repo" 2>/dev/null
  else
    gh repo view "$owner_repo" --json visibility -q .visibility 2>/dev/null
  fi
}

vis=$(lookup_vis)
vis_rc=$?
if [ $vis_rc -ne 0 ] || [ -z "$vis" ]; then
  echo "push-guard: unknown visibility for $owner_repo"
  exit 1
fi
vis=$(tr 'A-Z' 'a-z' <<<"$vis")
case "$vis" in
  private|internal) exit 0 ;;
  public) ;;
  *)
    echo "push-guard: unknown visibility for $owner_repo"
    exit 1
    ;;
esac

# 4–6. Check every ref; report all blocked; exit 1 if any blocked
blocked=0
for line in "${refs[@]}"; do
  read -r lref lsha rref rsha <<<"$line"

  commit=$(git rev-parse --verify -q "${lsha}^{commit}" 2>/dev/null) || commit=""
  if [ -z "$commit" ]; then
    echo "push-guard: cannot resolve $lsha to a commit"
    blocked=1
    continue
  fi

  if ! awk -F'\t' -v repo="$owner_repo_lower" -v sha="$commit" '
    BEGIN { found=0 }
    $2 == repo && $3 == sha { found=1 }
    END { exit found ? 0 : 1 }
  ' "$CLEAR_FILE" 2>/dev/null; then
    echo "push-guard: $commit not cleared for $owner_repo (reviewer: bash $0 --clear $owner_repo $commit \"<summary>\")"
    blocked=1
    continue
  fi

  # scrub: judge the pushed commit, never the working tree. The script runs from inside the
  # extracted copy, so one that scans "." sees the commit. It is the repo's own code: this
  # trusts the commits being pushed as much as running the repo's tests would.
  if git cat-file -e "$commit:bin/oss-scrub-check" 2>/dev/null; then
    tmp=$(mktemp -d) || { echo "push-guard: scrub could not start for $commit"; blocked=1; continue; }
    scrub_ok=0
    # A throwaway index, not git archive: archive honours export-ignore, which would hide a
    # pushed file from the scrub.
    if GIT_INDEX_FILE="$tmp/.idx" git read-tree "$commit" 2>/dev/null &&
       GIT_INDEX_FILE="$tmp/.idx" git checkout-index -a --prefix="$tmp/tree/" 2>/dev/null; then
      scrub_out=$(cd "$tmp/tree" && bash bin/oss-scrub-check </dev/null 2>&1) && scrub_ok=1
    fi
    rm -rf "$tmp"
    if [ "$scrub_ok" -ne 1 ]; then
      echo "push-guard: scrub failed for $commit; last lines:"
      printf '%s\n' "${scrub_out:-}" | tail -5 | sed 's/^/  /'
      blocked=1
      continue
    fi
  fi
done

if [ $blocked -ne 0 ]; then
  exit 1
fi
exit 0
