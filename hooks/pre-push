#!/usr/bin/env bash
# Global pre-push hook: secret scan + suspicious-file check, then public-push-guard. Fail-closed.
# Installed via: cp hooks/pre-push ~/.git-hooks/pre-push; git config --global core.hooksPath ~/.git-hooks
# stdin is read once and fed to both checks. Guard: ${PUBLIC_PUSH_GUARD:-~/repos/workbench/bin/public-push-guard}.
# Missing guard: refuse github.com URLs, skip others.
set -u
GUARD=${PUBLIC_PUSH_GUARD:-$HOME/repos/workbench/bin/public-push-guard}
stdin=$(cat)
ZERO=0000000000000000000000000000000000000000
EMPTY=4b825dc642cb6eb9a060e54bf8d69288fbee4904  # empty tree: a zero sha is not a valid diff base
PATTERNS='sk-ant-[A-Za-z0-9_-]{10,}|sk-proj-[A-Za-z0-9_-]{10,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|ghu_[A-Za-z0-9]{20,}|ghs_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AKIA[0-9A-Z]{16}|hf_[A-Za-z0-9]{20,}|AIza[0-9A-Za-z_-]{30,}|xox[baprs]-[A-Za-z0-9-]{10,}|BEGIN [A-Z ]*PRIVATE KEY|aws_secret_access_key[^A-Za-z0-9]{0,3}[A-Za-z0-9/+=]{40}'
BAD_NAMES='(^|/)\.env($|\.)|\.pem$|\.p12$|\.pfx$|id_rsa($|\.pub$)|id_ed25519$|.*credentials.*\.json$|.*\.sqlite(-wal|-shm)?$|secring\.gpg$|\.keystore$|npm-debug\.log$'

hits=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # branch deletion
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"                            # new ref: scan whole thing vs empty tree
    diff_cmd=(git diff --no-textconv --unified=0 "$EMPTY" "$local_sha")
    files_cmd=(git diff --no-textconv --name-only --diff-filter=A "$EMPTY" "$local_sha")
  else
    diff_cmd=(git diff --no-textconv --unified=0 "$remote_sha" "$local_sha")
    files_cmd=(git diff --no-textconv --name-only --diff-filter=A "$remote_sha" "$local_sha")
  fi

  # 1) secret patterns in ADDED lines
  # never echo the secret itself: hook output lands in terminals, logs, agent transcripts
  if m=$("${diff_cmd[@]}" 2>/dev/null | grep -E '^\+' | grep -vE '^\+\+\+' | grep -inE "$PATTERNS"); then
    sed -E 's/[A-Za-z0-9_/+=-]{12,}/<REDACTED>/g' <<<"$m"
    echo "pre-push: SECRET PATTERN in ${local_ref#refs/heads/} (redacted line above)"
    hits=1
  fi
  # 2) suspicious files being added
  if "${files_cmd[@]}" 2>/dev/null | grep -E "$BAD_NAMES"; then
    echo "pre-push: SUSPICIOUS FILE added to ${local_ref#refs/heads/} (should be gitignored?)"
    hits=1
  fi
done <<<"$stdin"

# 3) public-push-guard, same args and stdin
if [ -x "$GUARD" ]; then
  printf '%s\n' "$stdin" | "$GUARD" "$@" || hits=1
elif [[ "${2:-}" == *[Gg][Ii][Tt][Hh][Uu][Bb].[Cc][Oo][Mm]* ]]; then
  echo "pre-push: public-push-guard missing or not executable ($GUARD); refusing GitHub push" >&2
  hits=1
fi

if [ "$hits" -ne 0 ]; then
  echo "pre-push: PUSH BLOCKED. Bypass only with explicit human approval: git push --no-verify"
  exit 1
fi
exit 0
