#!/usr/bin/env bash
# waker-test — hermetic contract for bin/waker (control-pane spec section 7; epic repos-dg7w items 6-9, 11).
#
# bin/waker [--dry-run] runs ONE tick: no model, no loop. It prints one line per seat file,
#   seat=<name> <verdict> [bead=<id>] [reason]
# and exits 0. Verdicts:
#   started      a Lead session was started on its top ready bead (--dry-run: would-start, nothing run)
#   running      the seat already has a live session; nothing started
#   idle         no ready bead
#   budget-stop  Claude use is at 90% or more, or pace is above the seat's pace_max, or the meter is unreadable
#   claude-down  the file claude.down exists in the seat folder
#   no-slot      every Claude slot is taken by seats of higher priority
#   bad-seat     the seat file failed validation; it is named, skipped, and never stops the tick
# Off switch: while <seats>/waker.off exists the tick prints "waker: off" and does nothing else (exit 0).
#
# Seat file <seats>/<seat>.json:
#   {"seat":"<stem>","kind":"lead","repo":"<dir>","label":"<bead label>","priority":<int, 1 first>,
#    "pace_max":<number>,"env":["NAME",...],"start":"<shell command>"}
# The start command runs with ONLY the variables named in env (plus WAKER_SEAT and WAKER_BEAD): the per-seat
# secrets allowlist. Everything else in the waker's environment is dropped.
#
# Seams (env, all optional; defaults are the live commands):
#   WAKER_SEATS       seat folder                      (default ~/vault/director/seats)
#   WAKER_BUDGET      folder holding ignore-until      (default ~/vault/director/.budget)
#   WAKER_METER_CMD   prints "<util> <pace>" as fractions, or "? ?" when unreadable
#   WAKER_READY_CMD   "<cmd> <repo> <label>" prints the top ready bead id, or nothing
#   WAKER_ALIVE_CMD   "<cmd> <seat>" exits 0 when the seat has a live session
#   WAKER_CLAUDE_SLOTS  live Lead sessions allowed at once (default 2)
#   WAKER_DRAIN_CMD   run once at the end of every tick that is not off (the worker drainer); "" = none
set -u
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
waker=$here/waker
tmp=$(mktemp -d "${TMPDIR:-/tmp}/waker-test.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
fails=0
check() { if [ "$2" = "$3" ]; then echo "PASS  $1"; else echo "FAIL  $1: got '$2' want '$3'"; fails=1; fi; }
pre() { if grep -q -- "^$3" "$2"; then echo "PASS  $1"; else echo "FAIL  $1: no line starting '$3' in:"; sed 's/^/      /' "$2"; fails=1; fi; }
has() { if grep -qxF -- "$3" "$2"; then echo "PASS  $1"; else echo "FAIL  $1: no line '$3' in:"; sed 's/^/      /' "$2"; fails=1; fi; }

# --- stubs: every seam is a small script reading files under $tmp/w ---
mkdir -p "$tmp/bin" "$tmp/fake"
# No tick may reach the real tmux: a fake one is first on PATH for every tick, and the idle and
# nudge seams are stubbed unless a case clears them (case 29).
cat >"$tmp/fake/tmux" <<'TMUX'
#!/usr/bin/env bash
echo "$*" >>"$W/tmux.calls"
case $1 in
  display-message) cat "$W/activity" 2>/dev/null ;;
  capture-pane)    cat "$W/screen" 2>/dev/null ;;
  send-keys)       echo "$*" >>"$W/keys" ;;
  *)               exit 1 ;;
esac
TMUX
chmod +x "$tmp/fake/tmux"
export PATH="$tmp/fake:$PATH"   # also covers the calls below that do not go through tick
cat >"$tmp/bin/meter" <<'EOF'
#!/bin/bash
cat "$W/meter" 2>/dev/null || echo "? ?"
EOF
cat >"$tmp/bin/ready" <<'EOF'
#!/bin/bash
cat "$W/ready/$(basename "$1").$2" 2>/dev/null
EOF
cat >"$tmp/bin/alive" <<'EOF'
#!/bin/bash
[ -e "$W/alive/$1" ]
EOF
cat >"$tmp/bin/drain" <<'EOF'
#!/bin/bash
echo drained >>"$W/drain.log"
EOF
chmod +x "$tmp"/bin/*

# fresh world: three valid Lead seats (trading 1, ndv 2, stack 3), meter calm, nothing ready
world() {
  W=$tmp/w; command rm -rf "$W"; mkdir -p "$W"/{seats,budget,ready,alive,repos/trading,repos/ndv,repos/stack}
  echo "0.50 0.50" >"$W/meter"
  seat trading 1 1.0; seat ndv 2 1.1; seat stack 3 0.9
}
# seat <name> <priority> <pace_max>: start command records the seat, the bead and its whole environment
seat() {
  cat >"$W/seats/$1.json" <<EOF
{"seat":"$1","kind":"lead","repo":"$W/repos/$1","label":"lead","priority":$2,"pace_max":$3,
 "env":["KEEP_ME"],"start":"echo \$WAKER_SEAT \$WAKER_BEAD >>$W/started; env >$W/env.$1"}
EOF
}
ready() { echo "$2" >"$W/ready/$1.lead"; }
tick() {
  env W="$W" PATH="$tmp/fake:$PATH" WAKER_IDLE_CMD="$tmp/bin/idle" WAKER_NUDGE_CMD="$tmp/bin/nudge" \
    KEEP_ME=kept SECRET_TOKEN=leak WAKER_SEATS="$W/seats" WAKER_BUDGET="$W/budget" \
    WAKER_METER_CMD="$tmp/bin/meter" WAKER_READY_CMD="$tmp/bin/ready" WAKER_ALIVE_CMD="$tmp/bin/alive" \
    WAKER_DRAIN_CMD="$tmp/bin/drain" "$@" "$waker" >"$W/out" 2>"$W/err"; echo $? >"$W/rc"
}
started() { sort "$W/started" 2>/dev/null | tr '\n' ',' ; }

# 1. nothing ready: every seat idle, nothing started, drainer still runs, exit 0
world; tick
check "1 exit 0" "$(cat "$W/rc")" 0
has "1 trading idle" "$W/out" "seat=trading idle"
has "1 stack idle" "$W/out" "seat=stack idle"
check "1 nothing started" "$(started)" ""
check "1 drainer ran once" "$(wc -l <"$W/drain.log" 2>/dev/null)" 1

# 2. one ready bead: that seat starts on exactly that bead
world; ready ndv ndv-12; tick
has "2 ndv started" "$W/out" "seat=ndv started bead=ndv-12"
check "2 start saw seat and bead" "$(started)" "ndv ndv-12,"

# 3. secrets allowlist: the start command sees the named variable and not the others
check "3 allowlisted variable kept" "$(grep -c '^KEEP_ME=kept$' "$W/env.ndv")" 1
check "3 other variables dropped" "$(grep -c 'SECRET_TOKEN' "$W/env.ndv")" 0
check "3 the waker's own seams dropped" "$(grep -c '^WAKER_METER_CMD=' "$W/env.ndv")" 0

# 4. live session: running, not started again
world; ready ndv ndv-12; touch "$W/alive/ndv"; tick
has "4 ndv running" "$W/out" "seat=ndv running"
check "4 nothing started" "$(started)" ""

# 5. hard budget stop, per seat: pace 0.95 stops stack (0.9) but not trading (1.0) or ndv (1.1)
world; echo "0.50 0.95" >"$W/meter"; ready trading t-1; ready ndv n-1; ready stack s-1; tick WAKER_CLAUDE_SLOTS=3
pre "5 stack stopped" "$W/out" "seat=stack budget-stop bead=s-1 pace "
check "5 the other two started" "$(started)" "ndv n-1,trading t-1,"

# 6. use at 90% stops every seat, whatever the pace
world; echo "0.90 0.10" >"$W/meter"; ready trading t-1; tick
pre "6 trading stopped at 90%" "$W/out" "seat=trading budget-stop bead=t-1 use "
check "6 nothing started" "$(started)" ""

# 7. unreadable meter fails closed
world; echo "? ?" >"$W/meter"; ready trading t-1; tick
has "7 meter unreadable" "$W/out" "seat=trading budget-stop bead=t-1 meter unreadable"
check "7 nothing started" "$(started)" ""

# 8. operator override: ignore-until in the future lifts the pace and use stops; in the past it does nothing
world; echo "0.95 3.00" >"$W/meter"; ready trading t-1; echo $(( $(date +%s) + 600 )) >"$W/budget/ignore-until"; tick
check "8 future override starts" "$(started)" "trading t-1,"
world; echo "0.95 3.00" >"$W/meter"; ready trading t-1; echo $(( $(date +%s) - 600 )) >"$W/budget/ignore-until"; tick
check "8 expired override does not" "$(started)" ""

# 9. strict priority: one slot, three ready seats: the highest priority takes it
world; ready trading t-1; ready ndv n-1; ready stack s-1; tick WAKER_CLAUDE_SLOTS=1
check "9 only trading started" "$(started)" "trading t-1,"
has "9 ndv no-slot" "$W/out" "seat=ndv no-slot bead=n-1"
has "9 stack no-slot" "$W/out" "seat=stack no-slot bead=s-1"

# 10. a live session holds its slot: stack is running, one slot, so trading waits
world; ready trading t-1; touch "$W/alive/stack"; tick WAKER_CLAUDE_SLOTS=1
has "10 trading no-slot" "$W/out" "seat=trading no-slot bead=t-1"
check "10 nothing started" "$(started)" ""

# 11. a seat stopped by budget does not take a slot from a lower-priority seat
world; echo "0.50 1.05" >"$W/meter"; ready trading t-1; ready ndv n-1; tick WAKER_CLAUDE_SLOTS=1
pre "11 trading stopped" "$W/out" "seat=trading budget-stop bead=t-1 pace "
check "11 ndv took the slot" "$(started)" "ndv n-1,"

# 12. claude.down: no Lead starts; the drainer still runs
world; ready trading t-1; touch "$W/seats/claude.down"; tick
has "12 claude-down" "$W/out" "seat=trading claude-down bead=t-1"
check "12 nothing started" "$(started)" ""
check "12 drainer ran" "$(wc -l <"$W/drain.log" 2>/dev/null)" 1

# 13. off switch: one file stops everything, the drainer included
world; ready trading t-1; touch "$W/seats/waker.off"; tick
check "13 exit 0" "$(cat "$W/rc")" 0
check "13 says off" "$(cat "$W/out")" "waker: off"
check "13 nothing started" "$(started)" ""
check "13 drainer not run" "$([ -e "$W/drain.log" ] && echo ran || echo no)" no

# 14. --dry-run: says would-start, runs nothing
world; ready trading t-1; tick; : >"$W/started"; command rm -f "$W/drain.log"
env W="$W" WAKER_SEATS="$W/seats" WAKER_BUDGET="$W/budget" WAKER_METER_CMD="$tmp/bin/meter" WAKER_READY_CMD="$tmp/bin/ready" \
  WAKER_ALIVE_CMD="$tmp/bin/alive" WAKER_DRAIN_CMD="$tmp/bin/drain" "$waker" --dry-run >"$W/out" 2>"$W/err"
has "14 would-start" "$W/out" "seat=trading would-start bead=t-1"
check "14 nothing started" "$(started)" ""
check "14 drainer not run" "$([ -e "$W/drain.log" ] && echo ran || echo no)" no

# 15. bad seat files are named and skipped; good seats still run
world; ready ndv n-1
echo '{not json' >"$W/seats/broken.json"
echo '{"seat":"other","kind":"lead","repo":"'"$W"'/repos/ndv","label":"lead","priority":1,"pace_max":1,"env":[],"start":"true"}' >"$W/seats/misnamed.json"
echo '{"seat":"badenv","kind":"lead","repo":"'"$W"'/repos/ndv","label":"lead","priority":1,"pace_max":1,"env":["A B; rm"],"start":"true"}' >"$W/seats/badenv.json"
echo '{"seat":"norepo","kind":"lead","repo":"'"$W"'/repos/missing","label":"lead","priority":1,"pace_max":1,"env":[],"start":"true"}' >"$W/seats/norepo.json"
echo '{"seat":"nostart","kind":"lead","repo":"'"$W"'/repos/ndv","label":"lead","priority":1,"pace_max":1,"env":[]}' >"$W/seats/nostart.json"
echo '{"seat":"badprio","kind":"lead","repo":"'"$W"'/repos/ndv","label":"lead","priority":"high","pace_max":1,"env":[],"start":"true"}' >"$W/seats/badprio.json"
tick
check "15 exit 0" "$(cat "$W/rc")" 0
for s in broken misnamed badenv norepo nostart badprio; do
  check "15 $s is bad-seat" "$(grep -c "^seat=$s bad-seat" "$W/out")" 1
done
check "15 good seat still started" "$(started)" "ndv n-1,"

# 16. a worker seat file is valid and left to the drainer: listed, never started by the waker
world
echo '{"seat":"qwen","kind":"worker","repo":"'"$W"'/repos/stack","label":"lane:v100","priority":9,"pace_max":0,"env":[],"start":"true"}' >"$W/seats/qwen.json"
echo x >"$W/ready/stack.lane:v100"; tick
has "16 worker seat goes to the drainer" "$W/out" "seat=qwen drainer"
check "16 nothing started" "$(started)" ""

# 17. a start command that fails is reported and does not stop the tick
world; ready trading t-1; ready ndv n-1
sed -i 's|"start":"[^"]*"|"start":"exit 3"|' "$W/seats/trading.json"; tick
has "17 start failure named" "$W/out" "seat=trading start-failed bead=t-1 rc=3"
check "17 ndv still started" "$(started)" "ndv n-1,"
check "17 exit 0" "$(cat "$W/rc")" 0

# 18. a session the start command leaves running (a tmux server) must not keep the tick lock
world; ready trading t-1
sed -i 's|"start":"[^"]*"|"start":"sleep 20 >/dev/null 2>\&1 \& echo up"|' "$W/seats/trading.json"; tick
has "18 started" "$W/out" "seat=trading started bead=t-1"
tick
check "18 next tick is not locked out" "$(grep -c '^waker: locked' "$W/out")" 0
pkill -f "sleep 20" 2>/dev/null

# 19. the seat record is "|"-joined, one per line: those characters in repo, label or start make a bad seat
world; ready trading t-1; ready ndv n-1
jq -c '.label = "a|b"' "$W/seats/trading.json" >"$W/t" && mv "$W/t" "$W/seats/trading.json"
jq -c '.start = "echo a\necho b"' "$W/seats/ndv.json" >"$W/t" && mv "$W/t" "$W/seats/ndv.json"; tick
has "19 pipe in label" "$W/out" "seat=trading bad-seat bad character in repo, label or start"
has "19 newline in start" "$W/out" "seat=ndv bad-seat bad character in repo, label or start"
check "19 nothing started" "$(started)" ""

# 20. a slot count that is not a number means the default of 2, not "no limit"
world; ready trading t-1; ready ndv n-1; ready stack s-1; tick WAKER_CLAUDE_SLOTS=many
has "20 third seat has no slot" "$W/out" "seat=stack no-slot bead=s-1"

# 21. a seam that reads stdin must not swallow the remaining seats
world; ready trading t-1; ready ndv n-1
printf '#!/bin/bash\ncat >/dev/null\ncat "$W/ready/$(basename "$1").$2" 2>/dev/null\n' >"$tmp/bin/ready-stdin"; chmod +x "$tmp/bin/ready-stdin"
tick WAKER_READY_CMD="$tmp/bin/ready-stdin"
check "21 both seats started" "$(started)" "ndv n-1,trading t-1,"

# --- nudge: a live seat that sits idle while a bead is ready gets one message, not a second session ---
# Two more seams (defaults are the live tmux commands):
#   WAKER_IDLE_CMD    "<cmd> <seat>" exits 0 when the seat's live session is idle
#                     (default: the tmux session has printed nothing for WAKER_IDLE_S seconds, default 600)
#   WAKER_NUDGE_CMD   "<cmd> <seat> <bead>" tells the live session the bead is ready
#                     (default: tmux send-keys one line naming the bead, then Enter)
#   WAKER_NUDGE_GAP_S seconds before the same seat may be nudged again (default 1800; not a number = default)
# New verdicts: nudged bead=<id> | would-nudge bead=<id> (--dry-run) | nudge-failed bead=<id> rc=<n>.
# A live seat that is busy, has no ready bead, was nudged inside the gap, or is under a budget stop or
# claude.down stays "running". The last nudge time lives in <seats>/.nudge/<seat>.
cat >"$tmp/bin/idle" <<'EOF'
#!/bin/bash
[ -e "$W/idle/$1" ]
EOF
cat >"$tmp/bin/nudge" <<'EOF'
#!/bin/bash
echo "$1 $2" >>"$W/nudged"
exit "$(cat "$W/nudge-rc" 2>/dev/null || echo 0)"
EOF
chmod +x "$tmp/bin/idle" "$tmp/bin/nudge"
ntick() { tick WAKER_IDLE_CMD="$tmp/bin/idle" WAKER_NUDGE_CMD="$tmp/bin/nudge" "$@"; }
live_idle() { mkdir -p "$W/idle"; touch "$W/alive/$1" "$W/idle/$1"; }
nudged() { sort "$W/nudged" 2>/dev/null | tr '\n' ','; }

# 22. live, idle, bead ready: nudged with seat and bead; no second session is started
world; ready ndv n-7; live_idle ndv; ntick
has "22 ndv nudged" "$W/out" "seat=ndv nudged bead=n-7"
check "22 nudge saw seat and bead" "$(nudged)" "ndv n-7,"
check "22 nothing started" "$(started)" ""
check "22 no plain running line for ndv" "$(grep -c '^seat=ndv running' "$W/out")" 0

# 23. live and busy, or live and idle with nothing ready: running, no nudge
world; ready ndv n-7; touch "$W/alive/ndv"; live_idle trading; ntick
has "23 busy seat running" "$W/out" "seat=ndv running"
has "23 idle seat with no bead running" "$W/out" "seat=trading running"
check "23 nobody nudged" "$(nudged)" ""

# 24. the gap: a second tick does not nudge again; a gap of 0 does; a gap that is not a number is the default
world; ready ndv n-7; live_idle ndv; ntick; ntick
has "24 second tick is running" "$W/out" "seat=ndv running"
check "24 nudged once" "$(nudged)" "ndv n-7,"
ntick WAKER_NUDGE_GAP_S=0
check "24 gap 0 nudges again" "$(nudged)" "ndv n-7,ndv n-7,"
ntick WAKER_NUDGE_GAP_S=soon
check "24 bad gap means the default, not no gap" "$(nudged)" "ndv n-7,ndv n-7,"

# 25. --dry-run names the nudge and sends nothing, and does not start the gap
world; ready ndv n-7; live_idle ndv
env W="$W" PATH="$tmp/fake:$PATH" WAKER_SEATS="$W/seats" WAKER_BUDGET="$W/budget" WAKER_METER_CMD="$tmp/bin/meter" WAKER_READY_CMD="$tmp/bin/ready" \
  WAKER_ALIVE_CMD="$tmp/bin/alive" WAKER_IDLE_CMD="$tmp/bin/idle" WAKER_NUDGE_CMD="$tmp/bin/nudge" WAKER_DRAIN_CMD="" \
  "$waker" --dry-run >"$W/out" 2>"$W/err"
has "25 would-nudge" "$W/out" "seat=ndv would-nudge bead=n-7"
check "25 nothing sent" "$(nudged)" ""
ntick
check "25 real tick after a dry run still nudges" "$(nudged)" "ndv n-7,"

# 26. no nudge while Claude is down or the budget says stop; the seat stays running
world; ready ndv n-7; live_idle ndv; touch "$W/seats/claude.down"; ntick
has "26 claude.down: running" "$W/out" "seat=ndv running"
world; ready ndv n-7; live_idle ndv; echo "0.95 0.50" >"$W/meter"; ntick
has "26 budget stop: running" "$W/out" "seat=ndv running"
check "26 nobody nudged" "$(nudged)" ""

# 27. a nudge that fails is named, does not stop the tick, and does not start the gap
world; ready ndv n-7; ready stack s-1; live_idle ndv; echo 4 >"$W/nudge-rc"; ntick
has "27 failure named" "$W/out" "seat=ndv nudge-failed bead=n-7 rc=4"
check "27 other seat still started" "$(started)" "stack s-1,"
check "27 exit 0" "$(cat "$W/rc")" 0
echo 0 >"$W/nudge-rc"; ntick
check "27 retried on the next tick" "$(nudged)" "ndv n-7,ndv n-7,"

# 28. a nudged seat still holds its slot, and the off switch still stops everything
world; ready trading t-1; ready ndv n-7; ready stack s-1; live_idle ndv; ntick WAKER_CLAUDE_SLOTS=2
has "28 trading started" "$W/out" "seat=trading started bead=t-1"
has "28 stack has no slot" "$W/out" "seat=stack no-slot bead=s-1"
world; ready ndv n-7; live_idle ndv; touch "$W/seats/waker.off"; ntick
check "28 off: nobody nudged" "$(nudged)" ""

# 29. the default idle check and nudge (fake tmux): a quiet screen is nudged; a screen showing a
#     question is never typed into; a recently active or unreadable one is left alone
dtick() { tick WAKER_IDLE_CMD= WAKER_NUDGE_CMD= "$@"; }
quiet() { touch "$W/alive/ndv"; echo 1000 >"$W/activity"; printf '> \n' >"$W/screen"; }
world; ready ndv n-7; quiet; dtick
has "29 quiet screen nudged" "$W/out" "seat=ndv nudged bead=n-7"
check "29 keys name the bead" "$(grep -c 'bd show n-7' "$W/keys")" "1"
# repos-rkdda: text and Enter in one send-keys reach Claude Code as one paste, so the nudge sits unsent.
# The text goes literal (-l) in its own call; Enter is a separate, later call.
check "29 text sent literal" "$(grep -c -- '-l .*bd show n-7' "$W/keys")" "1"
check "29 text call has no Enter" "$(grep 'bd show n-7' "$W/keys" | grep -c 'Enter$')" "0"
check "29 Enter is its own call, last" "$(tail -1 "$W/keys")" "send-keys -t =ndv: Enter"
check "29 every tmux call names the exact session" "$(grep -vc -- '-t =ndv:' "$W/tmux.calls")" "0"
world; ready ndv n-7; quiet; printf 'Do you want to proceed?\n❯ 1. Yes\n' >"$W/screen"; dtick
has "29 dialog on screen: running" "$W/out" "seat=ndv running"
check "29 dialog on screen: nothing typed" "$(cat "$W/keys" 2>/dev/null)" ""
world; ready ndv n-7; quiet; date +%s >"$W/activity"; dtick
has "29 recent activity: running" "$W/out" "seat=ndv running"
world; ready ndv n-7; quiet; : >"$W/screen"; dtick
has "29 unreadable screen: running" "$W/out" "seat=ndv running"
world; ready ndv n-7; quiet; dtick WAKER_IDLE_S=soon
has "29 bad idle seconds means the default" "$W/out" "seat=ndv nudged bead=n-7"


# --- repos-pii1v: the Claude session window (5h limit) ---
# WAKER_SESSION_CMD prints the 5h session use as a fraction, or "?" when unreadable. At or above
# WAKER_SESSION_MAX (default 0.98) every Claude seat gets "session-out": no start, no nudge, even under the
# operator override (the override lifts pace rules; it cannot make an exhausted window answer).
# On the first tick after the window comes back, every live idle seat with a ready bead is nudged once,
# ignoring the nudge gap: one wake for all seats at reset. The window state lives in <seats>/.session-out.
cat >"$tmp/bin/session" <<'EOF'
#!/bin/bash
cat "$W/session" 2>/dev/null || echo "?"
EOF
chmod +x "$tmp/bin/session"
stick() { ntick WAKER_SESSION_CMD="$tmp/bin/session" "$@"; }

# 30. window exhausted, override on: nobody nudged or started, each Claude seat says session-out
world; echo $(( $(date +%s) + 600 )) >"$W/budget/ignore-until"; echo "1.00" >"$W/session"
ready ndv n-7; ready trading t-1; live_idle ndv; stick
pre "30 live seat session-out" "$W/out" "seat=ndv session-out"
pre "30 dead seat session-out" "$W/out" "seat=trading session-out"
check "30 nobody nudged" "$(nudged)" ""
check "30 nothing started" "$(started)" ""

# 31. next tick the window is back: the live idle seat is nudged at once, inside its nudge gap
mkdir -p "$W/seats/.nudge"; date +%s >"$W/seats/.nudge/ndv"
echo "0.02" >"$W/session"; stick
has "31 reset wakes the live seat" "$W/out" "seat=ndv nudged bead=n-7"
check "31 one wake" "$(nudged)" "ndv n-7,"
# 32. the tick after that: the gap applies again, no second wake
stick
check "32 no second wake" "$(nudged)" "ndv n-7,"

# 33. unreadable session meter changes nothing (fail open to today's rules)
world; ready ndv n-7; live_idle ndv; echo "?" >"$W/session"; stick
has "33 unreadable window: normal nudge" "$W/out" "seat=ndv nudged bead=n-7"

# --- repos-kcyh6: over its pace a seat halts and wakes only for P0; the first breach runs a usage profile once ---
# Seams: WAKER_PRIO_CMD "<cmd> <repo> <bead>" prints the bead's priority (0 = P0; unreadable = not P0)
#        WAKER_PROFILE_CMD "<cmd> <seat>" runs once when a seat first goes over its pace (marker <budget>/profiled-<seat>,
#        cleared on the first tick the seat is back at or under its pace_max)
cat >"$tmp/bin/prio" <<'EOF'
#!/bin/bash
cat "$W/prio/$2" 2>/dev/null
EOF
cat >"$tmp/bin/profile" <<'EOF'
#!/bin/bash
echo "$1" >>"$W/profiled"
EOF
chmod +x "$tmp/bin/prio" "$tmp/bin/profile"
ptick() { mkdir -p "$W/prio"; tick WAKER_PRIO_CMD="$tmp/bin/prio" WAKER_PROFILE_CMD="$tmp/bin/profile" "$@"; }
profiled() { sort "$W/profiled" 2>/dev/null | tr '\n' ',' ; }

# 34. over pace, ready bead is P0: the seat starts anyway
world; echo "0.50 0.95" >"$W/meter"; ready stack s-0; mkdir -p "$W/prio"; echo 0 >"$W/prio/s-0"; ptick
has "34 P0 starts over pace" "$W/out" "seat=stack started bead=s-0"
# 35. over pace, P1 bead (or unreadable priority): budget-stop as before
world; echo "0.50 0.95" >"$W/meter"; ready stack s-1; mkdir -p "$W/prio"; echo 1 >"$W/prio/s-1"; ptick
pre "35 P1 stopped over pace" "$W/out" "seat=stack budget-stop bead=s-1 pace "
world; echo "0.50 0.95" >"$W/meter"; ready stack s-1; ptick
pre "35 unreadable priority stopped" "$W/out" "seat=stack budget-stop bead=s-1 pace "
# 36. a live idle seat over pace is nudged only for P0
world; echo "0.50 0.95" >"$W/meter"; ready stack s-1; live_idle stack; mkdir -p "$W/prio"; echo 1 >"$W/prio/s-1"; ptick
has "36 P1 not nudged over pace" "$W/out" "seat=stack running"
world; echo "0.50 0.95" >"$W/meter"; ready stack s-0; live_idle stack; mkdir -p "$W/prio"; echo 0 >"$W/prio/s-0"; ptick
has "36 P0 nudged over pace" "$W/out" "seat=stack nudged bead=s-0"
# 37. use at 90% still stops a P0
world; echo "0.92 0.95" >"$W/meter"; ready stack s-0; mkdir -p "$W/prio"; echo 0 >"$W/prio/s-0"; ptick
pre "37 P0 stopped at 90% use" "$W/out" "seat=stack budget-stop bead=s-0 use "
# 38. the first breach profiles once; later ticks over pace do not; back under pace re-arms it
world; echo "0.50 0.95" >"$W/meter"; ptick; ptick
check "38 one profile per breach, only the seat over pace" "$(profiled)" "stack,"
echo "0.50 0.50" >"$W/meter"; ptick; echo "0.50 0.95" >"$W/meter"; ptick
check "38 a new breach profiles again" "$(profiled)" "stack,stack,"
# 39. the operator override suppresses the halt and the profile
world; echo "0.50 0.95" >"$W/meter"; ready stack s-1; echo $(( $(date +%s) + 600 )) >"$W/budget/ignore-until"; ptick
has "39 override starts P1" "$W/out" "seat=stack started bead=s-1"
check "39 override: no profile" "$(profiled)" ""

[ $fails = 0 ] && echo "waker-test: PASS" || echo "waker-test: FAIL"
exit $fails
