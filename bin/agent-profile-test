#!/usr/bin/env bash
# agent-profile-test — hermetic check for bin/agent-profile: a five-event session must split into
# 1.5 min model, 2 min tool, 40 min idle, with the idle stretch listed as woken by the waker.
set -u
here=$(cd "$(dirname "$0")" && pwd); tmp=$(mktemp -d); trap 'rm -r "$tmp"' EXIT
ev() { printf '{"type":"%s","timestamp":"2026-01-02T%sZ","message":{"content":%s}}\n' "$1" "$2" "$3"; }
{
  ev user      10:00:00 '"You are the **Test Lead**: go"'
  ev assistant 10:01:00 '[{"type":"tool_use","id":"t1","name":"Bash","input":{"command":"cd /x && gh pr view 1"}}]'
  ev user      10:03:00 '[{"type":"tool_result","tool_use_id":"t1","content":"ok"}]'
  ev assistant 10:03:30 '[{"type":"text","text":"You have hit your session limit, resets 12:30pm"}]'
  ev user      10:43:30 '"Waker: bead x-1 is ready"'
} > "$tmp/abcdef12-test.jsonl"
AGENT_PROFILE_NOW=2026-01-02T11:00:00 python3 "$here/agent-profile" "$tmp" "$tmp/abcdef12-test.jsonl" > "$tmp/out.txt" || { echo "FAIL: exit"; exit 1; }
python3 - "$tmp/abcdef12.json" <<'PY' && echo "PASS agent-profile-test"
import json, sys
r = json.load(open(sys.argv[1]))
assert r["wall_minutes"] == {"model": 1.5, "tool": 2.0, "idle": 40.0}, r["wall_minutes"]
assert r["tools_by_total_time"][0]["tool"] == "Bash:gh" and r["tools_by_total_time"][0]["max_s"] == 120, r["tools_by_total_time"]
i = r["longest_idles"][0]
assert (i["min"], i["ended_by"], r["seat"]) == (40.0, "waker", "Test Lead"), (i, r["seat"])
PY
