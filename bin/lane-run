#!/usr/bin/env bash
# lane-run — drain local-model beads through worker-task (sandboxed pi on the private lane).
#
#   lane-run [--repo DIR]... [--label lane:v100] [--lane private] [--once] [--idle 600]
#   (the public 9router lane is retired on home-lab-1: 9router moved to ai-lab-02, repos-mxu8 A, 2026-10-31)
#   --repo repeats; each pass drains one bead per repo in turn (default: $PWD).
#
# The decomposer (a frontier model, used sparingly) turns work into ~10-minute tasks a local
# model can finish: it pushes a branch whose HEAD is a failing test (the RED commit) and files
# a bead labelled lane:v100 whose description starts with
#   Branch: <branch>
#   Test: <command that goes RED -> GREEN>
#   Timeout: <worker seconds, optional; default 600, max 3600>
#   ---
#   <task prompt: one goal, exact files, nothing else>
# Success: bd close with the GREEN commit (worker-task pushes it and opens the PR).
# Failure: bd note + label qwen-failed; the decomposer re-splits it. Never retried blindly.
# SPRINT=<cmd> (optional) is called as `$SPRINT start <repo> <id>` / `$SPRINT end <id> <outcome> <finding> seconds=<n>`.
set -uo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
repos=() label=lane:v100 lane=private once= idle=600
while [ $# -gt 0 ]; do
  case $1 in
    --repo) repos+=("$(readlink -f "$2")"); shift 2 ;;
    --label) label=$2; shift 2 ;;
    --lane) lane=$2; shift 2 ;;
    --once) once=1; shift ;;
    --idle) idle=$2; shift 2 ;;
    -h|--help) sed -n '2,6s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "lane-run: unknown arg $1" >&2; exit 2 ;;
  esac
done
# a bad lane would fail every bead as the model's fault (qwen-failed) and poison the queue
[[ $lane == private ]] || { echo "lane-run: --lane private, got '$lane'" >&2; exit 2; }
[ ${#repos[@]} -gt 0 ] || repos=("$PWD")
[[ $idle =~ ^[0-9]+$ ]] || { echo "lane-run: --idle wants seconds, got '$idle'" >&2; exit 2; }
log() { echo "lane-run: $*" >&2; }
sprint() { [ -n "${SPRINT:-}" ] && $SPRINT "$@" >&2; return 0; }

# field <name> <description> — value of the first "Name: value" header line, before the --- fence
field() { awk -v k="$1:" '/^---$/{exit} index($0,k)==1{sub(k" *","");sub(/[ \t]+$/,"");print;exit}' <<<"$2"; }
# safe_branch <name> — only lane/* or v100/* branch names; blocks refspecs (+a:b), options and existing release branches
safe_branch() { [[ $1 =~ ^(lane|v100)/[A-Za-z0-9._/-]+$ ]] && git check-ref-format --branch "$1" >/dev/null 2>&1; }
# body <description> — everything after the first --- fence
body() { awk 'f{print} /^---$/{f=1}' <<<"$1"; }

# the last N lines worker-task itself logged (WORKER_TASK_LOG); pi and test output are worker-controlled
# text that the decomposer would read, so they never reach a bead
# worker logs persist here (not /tmp); wb-it5. GC runs once at start: only this dir, only files older than 14 days
logdir() { echo "${LANE_LOG_DIR:-$HOME/vault/director/worker-logs}"; }
gc_logs() { local d; d=$(logdir); [ -d "$d" ] && find "$d" -maxdepth 1 -type f -name '*.log' -mtime +14 -delete; return 0; }
# cause <rc> <wlog> <lf> — one-line specific reason for a failed run, from output already captured (wb-it5)
cause() {
  local c n t f d
  case $1 in
    5) c="checkout failed" ;;
    4) grep -q 'timed out' "$2" 2>/dev/null && c="timeout" ;;
    7) c=$(basediff "$3") ;;
    2) f=$(cat "$2" "$3" 2>/dev/null)
       d=$(basediff "$3")
       t=$(grep -m1 '^(fail) ' <<<"$f" | sed -E 's/^\(fail\) //; s/ \[[^]]*\]$//')
       n=$(grep -m1 -oE '^ *[0-9]+ fail' <<<"$f" | sed 's/^ *//')
       if grep -v baseline <<<"$f" | grep -qiE 'timed out|timeout'; then c="timeout${d:+; $d}"  # a parent-baseline timeout is not the worker's
       elif [ -n "$d" ]; then c=$d
       elif [ -n "$t" ]; then c="test $t${n:+ ($n)}"
       elif f=$(grep -m1 -oE '[^ ]+(\([0-9]+,[0-9]+\)|:[0-9]+:[0-9]+)[: -]+error TS[0-9]+' <<<"$f" | sed -E 's/(\([0-9]+,[0-9]+\)|:[0-9]+:[0-9]+).*//') && [ -n "$f" ]; then c="tsc $f"
       elif [ -n "$n" ]; then c="tests ($n)"; fi ;;
  esac
  [ -z "${c:-}" ] || printf ': %s' "${c:0:200}"
}
# failset (stdin) — sorted failing names in Test output: vitest "FAIL " and bun "(fail)" lines (ANSI colour
# stripped), and tsc diagnostics as "file(line,col): error TSnnnn" so a new error in an already-red file is new
failset() {
  local o; o=$(sed 's/\x1b\[[0-9;]*m//g')
  { sed -nE -e 's/^ *FAIL +//p' -e 's/^\(fail\) //p' <<<"$o" | sed -E 's/ +\[[^]]*\]$//; s/ +[0-9.]+ ?ms$//'
    grep -oE '[^ ]+(\([0-9]+,[0-9]+\)|:[0-9]+:[0-9]+)[: -]+error TS[0-9]+' <<<"$o" | sed -E 's/[: -]+error TS/: error TS/'
  } | LC_ALL=C sort -u
}
# prelude <lf> — the worker log up to worker-task's own "worker: lane=" line: its RED and parent-baseline runs,
# before pi ran, so nothing the model prints can forge them
prelude() { awk 'index($0,"worker-task: worker: ")==1{exit} {print}' "$1" 2>/dev/null; }
# section <marker> [last] (stdin) — output between worker-task's "worker-task: <marker>" log line and its next
# own line: the first such section, or with last=1 the last (GREEN runs after pi, so the last one is real)
section() {
  awk -v m="worker-task: $1" -v last="${2:-}" 'index($0,"worker-task: ")==1{ if(f&&!last)exit; f=index($0,m)==1; if(f)b=""; next }
    f{b=b $0 "\n"} END{printf "%s",b}'
}
both() { LC_ALL=C comm -12 <(printf '%s\n' "$1") <(printf '%s\n' "$2") | grep .; }
minus() { LC_ALL=C comm -23 <(printf '%s\n' "$1") <(printf '%s\n' "$2") | grep .; }
# shellcheck disable=SC2016 # awk program, not shell
names() { awk 'NF{printf "%s%s",s,$0; s=", "}' <<<"$1"; }
# basediff <lf> — GREEN's failures (A) against worker-task's runs before the model (wb-it5):
#   RED (R): the Test at the RED commit, where the target test is meant to fail
#   parent (P): the Test minus the RED tests at the RED commit's parent; only when that run was judged
# worker-introduced = A-R-P, target-still-failing = A∩R-P, baseline-red = A∩P (omitted when P never ran).
# No parseable RED failures: "baseline unknown". Empty when GREEN names nothing. Success stays the Test's exit code.
basediff() {
  local pre a r x p='' out=''
  a=$(section 'GREEN: ' 1 <"$1" | failset); [ -n "$a" ] || return 0
  pre=$(prelude "$1")
  r=$(section 'RED: ' <<<"$pre" | failset)
  [ -n "$r" ] || { printf 'baseline unknown; failing: %s' "$(names "$a")"; return 0; }
  if grep -q "^worker-task: baseline (RED's parent): " <<<"$pre" && ! grep -qE '^worker-task: baseline (timed out|checkout failed)' <<<"$pre"; then
    p=$(section "baseline (RED's parent): " <<<"$pre" | failset)
  fi
  x=$(minus "$(minus "$a" "$r")" "$p"); [ -z "$x" ] || out="worker-introduced: $(names "$x")"
  x=$(minus "$(both "$a" "$r")" "$p"); [ -z "$x" ] || out="${out:+$out; }target-still-failing: $(names "$x")"
  x=$(both "$a" "$p"); [ -z "$x" ] || out="${out:+$out; }baseline-red: $(names "$x")"
  printf '%s' "$out"
}
summary() { tail -"${2:-3}" "$1" 2>/dev/null | tr '\n' ' '; }

fail() { # fail <id> <why> [label] -- note, label (default qwen-failed: the decomposer re-splits it), reopen
  log "$1 FAILED: $2"
  bd -C "$repo" note "$1" "${3:-qwen-failed}: $2" >/dev/null
  bd -C "$repo" label add "$1" "${3:-qwen-failed}" >/dev/null
  bd -C "$repo" update "$1" -s open -a "" >/dev/null
}

# signal mid-run: stop the worker, hand the bead back, drop what this run made
interrupted() {
  if [ -n "$wpid" ]; then  # the worker may have pushed already, so a human looks (a rerun would read "already GREEN")
    kill -TERM -- -"$wpid" 2>/dev/null; wait "$wpid"
    keep=0
    if [ -n "$made" ]; then
      cur=$(git -C "$wt/wt" rev-parse HEAD 2>/dev/null)
      if [ -n "$cur" ] && [ "$cur" != "$base" ]; then keep=1; fi
    fi
    if [ "$keep" = "1" ]; then
      fail "$id" "lane-run interrupted; kept local branch $branch (worker commits, maybe unpushed); check origin/$branch (log: $lf)" human
    else
      fail "$id" "lane-run interrupted; check origin/$branch for a pushed GREEN (log: $lf)" human
    fi
  else
    log "$id: interrupted before the worker started"; bd -C "$repo" update "$id" -s open -a "" >/dev/null
  fi
  [ -z "$made" ] || { git -C "$repo" worktree remove --force "$wt/wt" 2>/dev/null; [ "$keep" = "1" ] || git -C "$repo" branch -q -D -- "$branch" 2>/dev/null; }
  rm -rf "$wt" "$task" "$wlog"; exit 130
}

down=
endpoint_up() {
  local port=${WORKER_PRIVATE_PORT:-8099}
  curl -sf -m 5 -o /dev/null "http://127.0.0.1:$port/v1/models" || { log "model endpoint :$port down; not claiming"; return 1; }
}
lane_busy() { # a saturated laneproxy queue would eat the worker's --timeout before the model runs
  [ -n "${LANES_URL:-}" ] || return 1
  local n; n=$(curl -s -m 5 "$LANES_URL" | jq -er '.waiting | length' 2>/dev/null) || return 1
  [ "$n" -ge "${LANE_MAX_WAITERS:-4}" ] || return 1
  log "lane busy ($n waiting); deferring"
}
run_one() { # 0 = worked a bead; 1 = nothing done in this repo (sets $down on an outage)
  local j id desc branch test wt= task= wlog= lf= wpid= made= rc t0 sha why sig= base= keep=
  endpoint_up || { down=1; return 1; }
  ! lane_busy || return 1
  # bd's stderr (warnings even on success) goes to our log, never into the JSON
  j=$(bd -C "$repo" ready --json -n 1 -l "$label" --exclude-label qwen-failed,human,lane-infra) \
    && id=$(jq -er '.[0].id // ""' <<<"$j") \
    || { log "$repo: bd ready failed or returned non-JSON"; down=1; return 1; }  # an outage, not an empty queue
  [ -n "$id" ] || return 1
  desc=$(jq -r '.[0].description // ""' <<<"$j"); desc=${desc//$'\r'/}
  branch=$(field Branch "$desc") test=$(field Test "$desc")
  # optional per-bead worker budget (a big GREEN outgrows worker-task's 600s); digits only, 1h lane ceiling
  tmo=$(field Timeout "$desc"); [[ $tmo =~ ^[123456789][0123456789]{0,5}$ ]] || tmo=600; [ "$tmo" -le 3600 ] || tmo=3600
  # a lost claim is no progress (returning 0 spun --once in a tight loop).
  # ponytail: a bead whose claim always fails starves its repo's queue; bd ready -n 1 keeps offering it.
  bd -C "$repo" update "$id" --claim >/dev/null 2>&1 || { log "$id: claim lost, skipping"; return 1; }
  # ponytail: SIGKILL still leaves the bead claimed; add a stale-claim sweep if lane-run ever gets killed that way
  trap interrupted INT TERM HUP
  sprint start "$repo" "$id"; t0=$(date +%s)
  if [ -z "$branch" ] || [ -z "$test" ] || [ -z "$(body "$desc")" ]; then
    fail "$id" "bead lacks Branch:/Test:/--- task"; sprint end "$id" blocked "malformed bead"; trap - INT TERM HUP; return 0
  fi
  if ! safe_branch "$branch"; then
    fail "$id" "Branch: must be lane/* or v100/* (got '$branch')"; sprint end "$id" blocked "unsafe branch"; trap - INT TERM HUP; return 0
  fi
  # a local branch of that name may hold someone's unpushed work: never reset or delete it
  if git -C "$repo" rev-parse -q --verify "refs/heads/$branch" >/dev/null; then
    fail "$id" "local branch $branch already exists in $repo; lane-run will not reset it" human
    sprint end "$id" blocked "local branch exists"; trap - INT TERM HUP; return 0
  fi
  log "▶ $id $branch"
  wt=$(mktemp -d "${TMPDIR:-/tmp}/lane-run.XXXXXX") task=$(mktemp "${TMPDIR:-/tmp}/lane-task.XXXXXX")
  wlog=$(mktemp "${TMPDIR:-/tmp}/lane-wlog.XXXXXX")
  mkdir -p "$(logdir)"; lf=$(logdir)/$id-$(date -u +%Y%m%dT%H%M%SZ).log; : >"$lf"
  body "$desc" >"$task"
  for try in 1 2 3; do  # a fast failure (443 refused) is usually a blip: retry before calling the branch missing (wb-o49)
    timeout 300 git -C "$repo" fetch -q origin -- "$branch"; rc=$?
    { [ $rc -eq 0 ] || [ $rc -eq 124 ] || [ $try -eq 3 ]; } && break; sleep 25
  done
  if [ $rc -eq 0 ] && git -C "$repo" worktree add -q -b "$branch" "$wt/wt" FETCH_HEAD; then
    made=1  # only a branch this run created is ever deleted (another process may make one meanwhile)
    base=$(git -C "$wt/wt" rev-parse HEAD)
    # own session, in the background: a signal to lane-run alone runs the trap now (bash defers traps
    # while a foreground child runs) and the trap kills the whole worker tree. -w: if setsid ever forks,
    # wait still sees the worker's rc (the group kill then misses; job control is off, so it doesn't)
    WORKER_TASK_LOG="$wlog" WORKER_DEPS="$repo/node_modules" WORKER_VENV="$repo/.venv" setsid -w "${WORKER_TASK:-$here/worker-task}" \
      --worktree "$wt/wt" --lane "$lane" --task "$task" --test "$test" --timeout "$tmo" --push >"$lf" 2>&1 & wpid=$!
    wait $wpid; rc=$?
    trap 'sig=1' INT TERM HUP  # the worker is done: finish recording its outcome, then exit
  elif [ $rc -eq 124 ]; then
    echo "fetch of origin/$branch timed out" >"$wlog"; rc=4
  elif ! timeout 60 git -C "$repo" ls-remote -q origin HEAD >/dev/null 2>&1; then
    echo "origin unreachable" >"$wlog"; rc=6  # an outage, not a missing branch
  else
    echo "could not check out origin/$branch" >"$wlog"; rc=5
  fi
  sha=$(git -C "$wt/wt" rev-parse --short HEAD 2>/dev/null)
  git -C "$repo" worktree remove --force "$wt/wt" 2>/dev/null; rm -rf "$wt" "$task"
  # worker-task: 0 GREEN, 2 the model failed, 3 GREEN but push/PR failed, 4 infra (worker never ran, or the runner crashed at startup in RED/GREEN),
  # 7 bead prep: GREEN failed, and the Test was already red before the RED commit
  case $rc in
    0) bd -C "$repo" close "$id" --reason "GREEN $sha on $branch: $(summary "$wlog" 1)" >/dev/null \
         || { log "$id: GREEN $sha pushed but bd close failed; bead left in_progress"; down=1; }
       log "■ $id done $sha"; sprint end "$id" done "GREEN $sha" seconds=$(( $(date +%s) - t0 ))
       rm -f "$lf" ;;
    2) fail "$id" "$(summary "$wlog") (log: $lf)"  # full worker output for a human; the bead keeps worker-task's own lines
       why="worker failed$(cause 2 "$wlog" "$lf")"; echo "lane-run: finding: $why" >>"$lf"
       sprint end "$id" blocked "$why" seconds=$(( $(date +%s) - t0 )) ;;
    4) # unblamed (not qwen-failed: nothing to re-split) and stop this pass, so one outage costs one bead,
       # not the queue; lane-infra is excluded from ready, so neither a dead endpoint nor a worker that
       # kills its own pi loops. ponytail: after an outage, `bd label remove <id> lane-infra` to retry
       fail "$id" "$(summary "$wlog") (log: $lf)" lane-infra; down=1
       sprint end "$id" blocked "infra$(cause 4 "$wlog" "$lf")" seconds=$(( $(date +%s) - t0 )) ;;
    7) # the bead's Test needs rescoping, not the model re-splitting or the queue stopping
       fail "$id" "$(summary "$wlog") (log: $lf)" human
       why="baseline red$(cause 7 "$wlog" "$lf")"; echo "lane-run: finding: $why" >>"$lf"
       sprint end "$id" blocked "$why" seconds=$(( $(date +%s) - t0 )) ;;
    6) # hand back unlabelled so the next pass retries it (2026-10-29: a GitHub 443 blip sent wb-an0.5.2 to a human)
       log "$id: origin unreachable; handed back for the next pass"
       bd -C "$repo" update "$id" -s open -a "" >/dev/null; down=1; rm -f "$lf"
       sprint end "$id" blocked "origin unreachable" seconds=$(( $(date +%s) - t0 )) ;;
    *) # 3 (GREEN commit on the local branch), 5 (branch missing on origin), anything unexpected
       fail "$id" "$(summary "$wlog") (rc=$rc${sha:+, $sha on local branch $branch}; log: $lf)" human
       sprint end "$id" blocked "rc=$rc$(cause "$rc" "$wlog" "$lf")" seconds=$(( $(date +%s) - t0 )) ;;
  esac
  # a failed branch's commits survive on origin as <branch>-failed-<epoch> before we drop the local copy
  if [ -n "$made" ] && [ $rc -ne 0 ] && [ $rc -ne 3 ] && [ "$(git -C "$repo" rev-parse -q --verify "refs/heads/$branch")" != "$base" ]; then
    timeout 300 git -C "$repo" push -q --no-verify origin "refs/heads/$branch:refs/heads/$branch-failed-$(date +%s)" 2>/dev/null || log "$id: could not push $branch-failed-*"
  fi
  # pushed or failed, the local branch is ours to drop; after rc=3 it holds the only copy of GREEN
  [ -z "$made" ] || [ $rc -eq 3 ] || git -C "$repo" branch -q -D -- "$branch" 2>/dev/null
  rm -f "$wlog"; trap - INT TERM HUP; [ -z "$sig" ] || exit 130
  [ -z "$down" ]
}

[ "${LANE_RUN_LIB:-}" ] && return 0 2>/dev/null  # sourced by the test
gc_logs
while :; do
  did= down=
  for repo in "${repos[@]}"; do run_one && did=1; [ -z "$down" ] || break; done
  [ -n "$once" ] && [ -n "$down" ] && exit 3
  [ -n "$did" ] && [ -z "$down" ] && continue
  [ -n "$once" ] && exit 0
  log "${down:+outage}${down:-queue empty}; idle ${idle}s"; sleep "$idle"
done
