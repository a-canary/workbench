#!/usr/bin/env bash
# lane-run — drain local-model beads through worker-task (sandboxed pi on the private lane).
#
#   lane-run [--repo DIR]... [--label lane:v100] [--once] [--idle 600]
#   --repo repeats; each pass drains one bead per repo in turn (default: $PWD).
#
# The decomposer (a frontier model, used sparingly) turns work into ~10-minute tasks a local
# model can finish: it pushes a branch whose HEAD is a failing test (the RED commit) and files
# a bead labelled lane:v100 whose description starts with
#   Branch: <branch>
#   Test: <command that goes RED -> GREEN>
#   ---
#   <task prompt: one goal, exact files, nothing else>
# Success: bd close with the GREEN commit (worker-task pushes it and opens the PR).
# Failure: bd note + label qwen-failed; the decomposer re-splits it. Never retried blindly.
# SPRINT=<cmd> (optional) is called as `$SPRINT start <repo> <id>` / `$SPRINT end <id> <outcome> <finding> seconds=<n>`.
set -uo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
repos=() label=lane:v100 once= idle=600
while [ $# -gt 0 ]; do
  case $1 in
    --repo) repos+=("$(readlink -f "$2")"); shift 2 ;;
    --label) label=$2; shift 2 ;;
    --once) once=1; shift ;;
    --idle) idle=$2; shift 2 ;;
    *) echo "lane-run: unknown arg $1" >&2; exit 2 ;;
  esac
done
[ ${#repos[@]} -gt 0 ] || repos=("$PWD")
[[ $idle =~ ^[0-9]+$ ]] || { echo "lane-run: --idle wants seconds, got '$idle'" >&2; exit 2; }
log() { echo "lane-run: $*" >&2; }
sprint() { [ -n "${SPRINT:-}" ] && $SPRINT "$@" >&2; return 0; }

# field <name> <description> — value of the first "Name: value" header line, before the --- fence
field() { awk -v k="$1:" '/^---$/{exit} index($0,k)==1{sub(k" *","");print;exit}' <<<"$2"; }
# safe_branch <name> — only lane/* or v100/* branch names; blocks refspecs (+a:b), options and existing release branches
safe_branch() { [[ $1 =~ ^(lane|v100)/[A-Za-z0-9._/-]+$ ]] && git check-ref-format --branch "$1" >/dev/null 2>&1; }
# body <description> — everything after the first --- fence
body() { awk 'f{print} /^---$/{f=1}' <<<"$1"; }

# the last N lines worker-task itself logged (WORKER_TASK_LOG); pi and test output are worker-controlled
# text that the decomposer would read, so they never reach a bead
summary() { tail -"${2:-3}" "$1" 2>/dev/null | tr '\n' ' '; }

fail() { # fail <id> <why> [label] -- note, label (default qwen-failed: the decomposer re-splits it), reopen
  log "$1 FAILED: $2"
  bd -C "$repo" note "$1" "${3:-qwen-failed}: $2" >/dev/null
  bd -C "$repo" label add "$1" "${3:-qwen-failed}" >/dev/null
  bd -C "$repo" update "$1" -s open -a "" >/dev/null
}

bd_down=
run_one() { # 0 = worked a bead; 1 = nothing done in this repo
  local j id desc branch test wt= task= wlog= out rc t0 sha
  if ! j=$(bd -C "$repo" ready --json -n 1 -l "$label" --exclude-label qwen-failed,human 2>&1); then
    log "$repo: bd ready failed: $(tail -1 <<<"$j")"; bd_down=1; return 1  # an outage, not an empty queue
  fi
  id=$(jq -r '.[0].id // empty' <<<"$j"); [ -n "$id" ] || return 1
  desc=$(jq -r '.[0].description // ""' <<<"$j"); desc=${desc//$'\r'/}
  branch=$(field Branch "$desc") test=$(field Test "$desc")
  # a lost claim is no progress (returning 0 spun --once in a tight loop).
  # ponytail: a bead whose claim always fails starves its repo's queue; bd ready -n 1 keeps offering it.
  bd -C "$repo" update "$id" --claim >/dev/null 2>&1 || { log "$id: claim lost, skipping"; return 1; }
  sprint start "$repo" "$id"; t0=$(date +%s)
  if [ -z "$branch" ] || [ -z "$test" ] || [ -z "$(body "$desc")" ]; then
    fail "$id" "bead lacks Branch:/Test:/--- task"; sprint end "$id" blocked "malformed bead"; return 0
  fi
  if ! safe_branch "$branch"; then
    fail "$id" "Branch: must be lane/* or v100/* (got '$branch')"; sprint end "$id" blocked "unsafe branch"; return 0
  fi
  log "▶ $id $branch"
  wt=$(mktemp -d "${TMPDIR:-/tmp}/lane-run.XXXXXX") task=$(mktemp "${TMPDIR:-/tmp}/lane-task.XXXXXX") wlog=$(mktemp "${TMPDIR:-/tmp}/lane-wlog.XXXXXX")
  # killed mid-run: reopen the bead (not qwen-failed: not the model's fault) and drop the worktree
  trap 'fail "$id" "lane-run interrupted" lane-interrupted; git -C "$repo" worktree remove --force "$wt/wt" 2>/dev/null; rm -rf "$wt" "$task" "$wlog"; exit 130' INT TERM HUP
  body "$desc" >"$task"
  if timeout 300 git -C "$repo" fetch -q origin -- "$branch" && git -C "$repo" worktree add -q -B "$branch" "$wt/wt" FETCH_HEAD; then
    out=$(WORKER_TASK_LOG="$wlog" WORKER_DEPS="$repo/node_modules" "${WORKER_TASK:-$here/worker-task}" --worktree "$wt/wt" --lane private --task "$task" --test "$test" --push 2>&1)
    rc=$?
  else
    echo "could not check out origin/$branch" >"$wlog"; out=; rc=2
  fi
  sha=$(git -C "$wt/wt" rev-parse --short HEAD 2>/dev/null)
  git -C "$repo" worktree remove --force "$wt/wt" 2>/dev/null; rm -rf "$wt" "$task"
  case $rc in
    0) bd -C "$repo" close "$id" --reason "GREEN $sha on $branch: $(summary "$wlog" 1)" >/dev/null
       log "■ $id done $sha"; sprint end "$id" done "GREEN $sha" seconds=$(( $(date +%s) - t0 ))
       git -C "$repo" branch -q -D -- "$branch" 2>/dev/null ;;  # pushed; a stale local copy would only confuse -B
    3) # GREEN commit made, push or PR failed: keep the local branch and hand it to a human
       fail "$id" "$(summary "$wlog") (GREEN $sha on local branch $branch)" human
       sprint end "$id" blocked "push/PR failed" seconds=$(( $(date +%s) - t0 )) ;;
    *) local lf; lf=$(mktemp "${TMPDIR:-/tmp}/lane-run-$id.XXXXXX")
       printf '%s\n' "$out" >"$lf"  # full worker output for a human; the bead keeps worker-task's own lines
       fail "$id" "$(summary "$wlog") (log: $lf)"
       sprint end "$id" blocked "worker failed rc=$rc" seconds=$(( $(date +%s) - t0 ))
       git -C "$repo" branch -q -D -- "$branch" 2>/dev/null ;;
  esac
  rm -f "$wlog"; trap - INT TERM HUP
}

[ "${LANE_RUN_LIB:-}" ] && return 0 2>/dev/null  # sourced by the test
while :; do
  did= bd_down=
  for repo in "${repos[@]}"; do run_one && did=1; done
  [ -n "$did" ] && continue
  [ -n "$once" ] && { [ -z "$bd_down" ] || exit 3; exit 0; }
  log "queue empty; idle ${idle}s"; sleep "$idle"
done
