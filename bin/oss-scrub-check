#!/usr/bin/env bash
# oss-scrub-check — fail if tracked files carry operator identity, private hosts, or absolute home paths.
#   bin/oss-scrub-check        exit 0 = clean; exit 1 = prints file:line hits
# Generic roles only (operator, worker); paths via $HOME or env overrides. /home/worker and /home/testuser
# are sandbox/test fixtures, not identity.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 2
pat='\baaron\b|enzonic|ndivisible|onenation|ournation|home-lab-[0-9]|ai-lab-[0-9]|/home/[a-z][a-z0-9_-]*/'
hits=$(git grep -I -n -i -E "$pat" -- . ':!bin/oss-scrub-check' | grep -v -E '/home/(worker|testuser)/')
[ -z "$hits" ] && { echo "oss-scrub-check: clean"; exit 0; }
printf '%s\n' "$hits"
echo "oss-scrub-check: $(printf '%s\n' "$hits" | wc -l) hit(s)" >&2
exit 1
