#!/usr/bin/env bash
# floor-run — bench adapter: run one worker seat on an instruction inside the jail.
set -uo pipefail
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
die() { echo "floor-run: $*" >&2; exit 2; }

rung=; instruction=; have=
while [ $# -gt 0 ]; do
  case $1 in
    --rung) rung=${2:-}; shift; [ $# -eq 0 ] || shift ;;
    *) [ -z "$have" ] || die "more than one instruction"; have=1; instruction="$1"; shift ;;
  esac
done
[ "$rung" = worker ] || die "unknown rung: $rung"
[ -n "$instruction" ] || die "missing instruction"
# The metrics file must not sit in the work dir, where it would count as the worker's change.
if [ -n "${FLOOR_METRICS:-}" ]; then
  case $FLOOR_METRICS in /*) ;; *) die "FLOOR_METRICS must be an absolute path" ;; esac
  FLOOR_METRICS=$(realpath -m -- "$FLOOR_METRICS")   # resolved once: the check and the write use the same path
  case $FLOOR_METRICS in "$(pwd -P)"/*) die "FLOOR_METRICS must be outside the work dir" ;; esac
fi

if [ -n "${WORKER_PRIVATE_PORT:-}" ] && [ "$WORKER_PRIVATE_PORT" != 8099 ]; then
  die "foreign WORKER_PRIVATE_PORT: $WORKER_PRIVATE_PORT"
fi

# Task limit: must be a whole number of milliseconds, at least 30 s, before anything runs.
if [ -n "${BENCH_TASK_TIMEOUT_MS:-}" ]; then
  [[ "$BENCH_TASK_TIMEOUT_MS" =~ ^[1-9][0-9]*$ ]] && [ "$BENCH_TASK_TIMEOUT_MS" -ge 30000 ] \
    || die "BENCH_TASK_TIMEOUT_MS must be an integer >= 30000, got: ${BENCH_TASK_TIMEOUT_MS:-unset}"
  limit=$(( BENCH_TASK_TIMEOUT_MS / 1000 - 15 ))
else
  limit=600
fi

# floor-run only commits into a repo it made itself: no git redirection from the caller, no existing repo.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_COMMON_DIR GIT_NAMESPACE
# Its own git calls read no git config from the machine or the caller, and run no hook or monitor.
unset GIT_TEMPLATE_DIR GIT_CONFIG_COUNT GIT_CONFIG_PARAMETERS
g() { GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 git -c core.fsmonitor= -c core.hooksPath=/dev/null "$@"; }
[ -e .git ] || [ -L .git ] && die "work dir is already a git repo"
# Host-side git never walks into a repo it did not make; temp files stay outside the work dir.
nested() { find . -mindepth 2 -name .git -print -quit 2>/dev/null; }
[ -z "$(nested)" ] || die "work dir contains a nested git repo"
TMPDIR=$(realpath -m -- "${TMPDIR:-/tmp}"); export TMPDIR   # resolved once, as above
case $TMPDIR in "$(pwd -P)"|"$(pwd -P)"/*) die "TMPDIR must be outside the work dir" ;; esac
g init -q 2>/dev/null
# The repo git finds from here must be the one just made, never one further up.
if [ "$(cd "$(g rev-parse --absolute-git-dir 2>/dev/null)" 2>/dev/null && pwd -P)" != "$(pwd -P)/.git" ]; then
  echo "floor-run: setup failed: the work dir has no repo of its own" >&2
  exit 4
fi
mkdir -p .git/info
{ echo '__pycache__/'
  echo '*.pyc'
  echo 'node_modules/'
  echo '.pytest_cache/'
  echo '.venv/'
} >> .git/info/exclude
g add -A 2>/dev/null
g -c user.name=floor-run -c user.email=floor-run@localhost -c commit.gpgsign=false \
    commit -q --allow-empty -m setup >/dev/null 2>&1
if ! g rev-parse -q --verify HEAD >/dev/null || [ -n "$(g status --porcelain 2>&1)" ]; then   # same test as after the run
  echo "floor-run: setup commit failed" >&2
  exit 4
fi
base=$(g rev-parse HEAD)

# Task file outside workdir
taskfile=$(mktemp) || { echo "floor-run: setup failed: no temp file" >&2; exit 4; }
trap 'rm -f "$taskfile" "${outfile:-}"' EXIT
{
  printf '%s\n' "$instruction"
  echo ""
  echo "If you cannot do this, end your reply with one last line starting with CANNOT-DO: and the reason. If a tool is broken, start that last line with TOOL-FAULT:."
} > "$taskfile"

# Run sandbox
outfile=$(mktemp) || { echo "floor-run: setup failed: no temp file" >&2; exit 4; }
start=$SECONDS
"${WORKER_SANDBOX:-$here/worker-sandbox}" --worktree "$PWD" --lane private \
    --task "$taskfile" --role worker --timeout "$limit" | tee "$outfile"
sandbox_rc=${PIPESTATUS[0]}
elapsed=$(( SECONDS - start ))

# A way out (even TOOL-FAULT) is the worker's own report, so it is a model outcome: exit 0, recorded in the metrics line.
way_out=
lastline=$(grep -av '^[[:space:]]*$' "$outfile" | tail -1)
if [[ "$lastline" == CANNOT-DO:* ]]; then
  way_out=CANNOT-DO
elif [[ "$lastline" == TOOL-FAULT:* ]]; then
  way_out=TOOL-FAULT
fi

# Metrics
if [ -n "${FLOOR_METRICS:-}" ]; then
  wb_sha=$(g -C "$here" rev-parse HEAD 2>/dev/null) || wb_sha=
  jq -nc --argjson rc "$sandbox_rc" --argjson secs "$elapsed" \
      --arg wo "${way_out:-}" --arg sha "$wb_sha" \
      '{rung:"worker", sandbox_rc:$rc, way_out:(if $wo=="" then null else $wo end),
        seconds:$secs, workbench_sha:(if $sha=="" then null else $sha end)}' >> "$FLOOR_METRICS" \
    || echo "floor-run: metrics line not written" >&2
fi

# Exit code: infra fault only when the sandbox failed and nothing changed (including committed).
# The sandbox masks .git, so the worker cannot edit the repo's git config either.
# A repo the worker made is a change in itself, and so is anything git status complains about.
# Changes only in ignored paths (the litter list, or the task's own .gitignore) do not count.
if [ -n "$(nested)" ]; then changed=nested-repo
else changed=$(g status --porcelain 2>&1) || changed=status-failed; fi
if [ "$sandbox_rc" = 0 ] || [ "$sandbox_rc" = 124 ] || [ -n "$way_out" ] || [ -n "$changed" ] || \
   [ "$(g rev-parse HEAD)" != "$base" ]; then
  exit 0
else
  exit 4
fi
