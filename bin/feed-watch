#!/usr/bin/env bash
# feed-watch — one tick: wake the Assistant when something landed or a failure appeared.
#
# Compares landed items and failure lines against the previous tick's state and
# wakes once if anything is new. Exit 0 always, except when the state folder
# cannot be created or written (exit 1).
#
# Seams (env, all optional):
#   FEED_STATE        state folder
#   FEED_LANDED_CMD   prints one line per landed item (first word is id)
#   FEED_FAIL_CMD     prints one line per current failure
#   FEED_WAKE_CMD     gets the whole message as one argument; "" = never wake
set -u
STATE="${FEED_STATE:-$HOME/vault/director/state/feed-watch}"
LANDED_CMD="${FEED_LANDED_CMD:-}"
FAIL_CMD="${FEED_FAIL_CMD:-}"
WAKE_CMD="${FEED_WAKE_CMD:-}"
if [ -z "$LANDED_CMD" ]; then def=$(dirname "$0")/feed-landed; [ -x "$def" ] && LANDED_CMD="$def" || LANDED_CMD=":"; fi
if [ -z "$FAIL_CMD" ]; then def=$(dirname "$0")/feed-failures; [ -x "$def" ] && FAIL_CMD="$def" || FAIL_CMD=":"; fi
mkdir -p "$STATE" || exit 1
SEEN="$STATE/landed.seen"; LAST="$STATE/failures.last"
prev_seen=""; [ -f "$SEEN" ] && prev_seen=$(cat "$SEEN")
prev_fails=""; [ -f "$LAST" ] && prev_fails=$(cat "$LAST")
landed_lines=""; cur_fails=""
if [ -n "$LANDED_CMD" ]; then
    if out=$($LANDED_CMD 2>/dev/null); then landed_lines=$out
    else rc=$?; cur_fails="feed-watch: landed check failed rc=$rc"; fi
fi
if [ -n "$FAIL_CMD" ]; then
    if out=$($FAIL_CMD 2>/dev/null); then
        [ -n "$out" ] && cur_fails="${cur_fails:+$cur_fails
}$out"
    else
        rc=$?  # the previous set is carried over, so failures it held do not wake again when the check recovers
        cur_fails="${cur_fails:+$cur_fails
}feed-watch: failures check failed rc=$rc${prev_fails:+
$prev_fails}"
    fi
fi
new_landed=""; landed_count=0
if [ -n "$landed_lines" ]; then
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        id=${line%% *}
        if [ -z "$prev_seen" ] || ! grep -qxF -- "$id" <<<"$prev_seen"; then
            new_landed="${new_landed:+$new_landed
}$line"; landed_count=$((landed_count + 1))
        fi
    done <<<"$landed_lines"
fi
new_fails=""; fail_count=0
if [ -n "$cur_fails" ]; then
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        if [ -z "$prev_fails" ] || ! grep -qxF -- "$line" <<<"$prev_fails"; then
            new_fails="${new_fails:+$new_fails
}$line"; fail_count=$((fail_count + 1))
        fi
    done <<<"$cur_fails"
fi
write_state() {
    local tmp
    tmp=$(mktemp "$SEEN.XXXXXX") || exit 1
    { [ -s "$SEEN" ] && cat "$SEEN"; [ -n "$landed_lines" ] && echo "$landed_lines" | awk 'NF{print $1}'; } | sort -u > "$tmp" || exit 1
    mv -f "$tmp" "$SEEN" || exit 1
    tmp=$(mktemp "$LAST.XXXXXX") || exit 1
    if [ -n "$cur_fails" ]; then echo "$cur_fails" > "$tmp" || exit 1
    else : > "$tmp" || exit 1; fi
    mv -f "$tmp" "$LAST" || exit 1
}
if [ -z "$new_landed" ] && [ -z "$new_fails" ]; then
    write_state; echo "feed-watch: quiet"; exit 0
fi
msg="feed: $landed_count landed, $fail_count new failures"
[ -n "$new_fails" ] && msg="$msg
$(head -n 10 <<<"$new_fails")"
[ -n "$new_landed" ] && msg="$msg
$(head -n 10 <<<"$new_landed")"
if [ -n "$WAKE_CMD" ]; then
    if ! "$WAKE_CMD" "$msg"; then echo "feed-watch: wake failed"; exit 0; fi
fi
write_state
[ -n "$WAKE_CMD" ] && echo "feed-watch: woke landed=$landed_count failures=$fail_count"
exit 0
