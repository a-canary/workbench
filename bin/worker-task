#!/usr/bin/env bash
# worker-task — one TDD worker run: RED -> sandboxed pi -> GREEN -> leak scan -> commit.
#
#   worker-task --worktree DIR --lane private|public --task FILE --test CMD \
#               [--tools read,edit,write,bash] [--timeout 600] [--push]
#
# Contract: the worktree's HEAD commit is the director's failing test (RED commit).
# The worker may not touch any file that commit touched, nor test/runner config
# (package.json, conftest.py, ...), so it can't "pass" by editing the test or how
# it runs. Tests run inside the jail too: worker-written code never runs
# on the host. Exit 0 = GREEN commit made (and pushed + PR opened with --push).
set -euo pipefail

log() { echo "worker-task: $*" >&2; [ -z "${WORKER_TASK_LOG:-}" ] || echo "$*" >>"$WORKER_TASK_LOG"; }
die() { log "$*"; exit 2; }
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

wt= lane= task= test= tools=read,edit,write,bash tmo=600 push=
while [ $# -gt 0 ]; do
  case $1 in
    --worktree) wt=$2; shift 2 ;;
    --lane) lane=$2; shift 2 ;;
    --task) task=$2; shift 2 ;;
    --test) test=$2; shift 2 ;;
    --tools) tools=$2; shift 2 ;;
    --timeout) tmo=$2; shift 2 ;;
    --push) push=1; shift ;;
    *) die "unknown arg $1" ;;
  esac
done
[ -d "$wt" ] && [ -f "$task" ] && [ -n "$test" ] && [ -n "$lane" ] || die "--worktree --lane --task --test required"
# host git never runs worker-controlled config (fsmonitor) and never descends into submodules
# host-side git: core.hooksPath may point into the tree (.githooks, .husky), where the worker writes hooks;
# quotePath off so non-ASCII names match as pathspecs and patterns instead of slipping past them quoted
g() { git -C "$wt" -c core.fsmonitor= -c core.hooksPath=/dev/null -c core.quotePath=false "$@"; }
g diff --quiet HEAD && [ -z "$(g status --porcelain --ignore-submodules=all)" ] || die "worktree not clean"

sbx() { "${WORKER_SANDBOX:-$here/worker-sandbox}" --worktree "$wt" --lane "$lane" "$@"; }

mapfile -d '' -t protected < <(g show -z --name-only --format= HEAD)
[ ${#protected[@]} -gt 0 ] || die "HEAD (RED commit) touches no files"
# read before the worker runs (the jail masks .git anyway)
may_edit=$(g log -1 --format='%(trailers:key=Worker-May-Edit,valueonly)' HEAD | { grep -v '^[[:space:]]*$' || true; } | paste -sd'|')
[ -z "$may_edit" ] || ! grep -qE -- "$may_edit" <<<$'\nzz/never-a-real-path.q' || die "Worker-May-Edit '$may_edit' matches every path"
# files that change how the test runs or what the leak scan sees, matched anywhere in the tree:
# manifests/locks, *config* and rc/env dotfiles, toml/ini/cfg, make, python import hooks, compiled .pyc,
# git attributes, gitleaks config. ponytail: a denylist; the upgrade is the RED commit declaring the
# paths the worker may touch (allowlist). Until then the RED commit can exempt paths explicitly with a
# trailer, e.g. "Worker-May-Edit: ^tsconfig\.json$" (an ERE matched against each changed path).
runner_cfg='(^|/)(package\.json|[^/]*\.lockb?|[^/]*[.-]config\.[cm]?[jt]s|[^/]*config[^/]*\.(json|toml|ya?ml)|[^/]*\.(toml|ini|cfg|pth|py[co]|mk)|\.[^/]*rc(\.[a-z]+)?|\.env[^/]*|(GNU)?[Mm]akefile|justfile|conftest\.py|pytest\.py|[^/]*customize\.py|vitest\.workspace[^/]*|\.git(attributes|modules)|\.gitleaks(\.toml|ignore))$'

# capture test output to detect startup crashes (infra) vs real failures
red_out=$(mktemp "${TMPDIR:-/tmp}/worker-red.XXXXXX")
green_out=$(mktemp "${TMPDIR:-/tmp}/worker-green.XXXXXX")
trap 'rm -rf "$red_out" "$green_out"; [ -n "${green:-}" ] && rm -rf "$green"' EXIT

startup_crash() {
  grep -qE 'EROFS: read-only file system|failed to load config|Startup Error' "$1"
}

log "RED: $test"
if sbx --timeout 300 --exec sh -c "$test" >"$red_out" 2>&1; then
  cat "$red_out" >&2
  die "test already passes — not a RED commit"
fi
cat "$red_out" >&2
if startup_crash "$red_out"; then
  log "RED crashed at startup (infra, not a valid RED)"
  exit 4
fi

log "worker: lane=$lane tools=$tools"
t0=$(date +%s)
wrc=0; sbx --task "$task" --tools "$tools" --timeout "$tmo" >&2 || { wrc=$?; log "worker rc=$wrc (judging by tests)"; }
log "worker took $(( $(date +%s) - t0 ))s"

# a nested repo's .git/config would run on the host's next git call (fsmonitor, hooks)
[ -z "$(find "$wt" -mindepth 2 -name .git -print -quit)" ] || die "worker created a nested .git"
g diff --quiet HEAD -- "${protected[@]}" || die "worker modified protected test files: ${protected[*]}"
g add -A
g diff --cached --raw | grep -q ' 160000 ' && die "worker staged a gitlink"
g diff --cached --quiet && { [ "$wrc" -eq 0 ] || [ "$wrc" -eq 124 ] || { log "worker exited rc=$wrc with no changes (endpoint or sandbox down?)"; exit 4; }; die "worker produced no changes"; }
# --no-renames: a rename would list only its new name and hide the config file it removed
# names go to a file first so a git error dies here instead of reading as "no config files"
names=$(mktemp "${TMPDIR:-/tmp}/worker-names.XXXXXX")
g diff --cached --no-renames --name-only -z > "$names" || { rm -f "$names"; die "git diff --cached failed; config check cannot run"; }
cfg=$({ grep -zE "$runner_cfg" "$names" || true; } | { [ -n "$may_edit" ] && grep -zvE -- "$may_edit" || cat; } | tr '\0' ' ')
rm -f "$names"
[ -z "$cfg" ] || { echo "worker-task: config files: $cfg" >&2
  die "worker modified $(wc -w <<<"$cfg") test/runner config file(s) (RED commit can allow with Worker-May-Edit:)"; }

# GREEN runs on a fresh checkout of exactly what will be committed: git-ignored or untracked files
# the worker left in the worktree (a stub module, a forged .pyc, a patched node_modules) never shape it.
# GREEN is evidence, not proof: the test runs worker-written code, which can simply exit 0 (os._exit
# at import, a shadowed test runner package). The gate is review of the PR diff before merge.
green=$(mktemp -d "${TMPDIR:-/tmp}/worker-green.XXXXXX")
g checkout-index -a --prefix="$green/"
log "GREEN: $test"
"${WORKER_SANDBOX:-$here/worker-sandbox}" --worktree "$green" --lane private --timeout 300 --exec sh -c "$test" >"$green_out" 2>&1 || {
  cat "$green_out" >&2
  if startup_crash "$green_out"; then
    log "GREEN crashed at startup (infra)"
    exit 4
  fi
  die "test still fails after worker"
}
cat "$green_out" >&2

# leak scan with the host's pinned config: a worker-written .gitleaks.toml would otherwise allowlist its own leak.
# (The lane key never enters the jail: the relay adds it host-side.)
(cd "$wt" && gitleaks protect --staged --redact --no-banner --config "$here/gitleaks.toml" >&2) || die "gitleaks flagged the diff"

subj="worker: $(head -c 60 "$task" | head -1)"
g -c user.name="${WORKER_GIT_NAME:-pi-worker}" -c user.email="${WORKER_GIT_EMAIL:-pi-worker@localhost}" \
  commit -q --no-verify -m "$subj" -m "Test: $test (RED->GREEN in sandbox, lane=$lane)"
log "committed $(g rev-parse --short HEAD)"

if [ -n "$push" ]; then
  g push -q --no-verify -u origin HEAD || { log "push failed; GREEN commit kept on the local branch"; exit 3; }
  # --base: never trust the GitHub default branch; arc-webui's was a 3-month-stale master (wb-7xq).
  base=${WORKER_BASE:-$(g rev-parse -q --verify refs/remotes/origin/main >/dev/null && echo main || echo master)}
  # api.github.com refused intermittently (2 of 5 lane runs, 2026-10-29), turning GREEN into rc=3 human work: retry.
  # ponytail: fixed 3 tries at 20/40 s; an existing PR for the branch also fails all three (still rc=3, harmless).
  for i in 1 2 3; do
    (cd "$wt" && gh pr create --fill --base "$base" --head "$(git branch --show-current)") && break
    # a re-run onto a branch whose PR is already open: the push updated that PR, so GREEN is delivered (nd-ubf.1, 2026-10-29)
    [ "$(cd "$wt" && gh pr view "$(git branch --show-current)" --json state -q .state 2>/dev/null)" = OPEN ] && { log "PR already open; push updated it"; break; }
    [ "$i" = 3 ] && { log "PR create failed; branch pushed"; exit 3; }
    sleep $((i * ${WORKER_PR_RETRY_S:-20}))
  done
fi
