#!/usr/bin/env bash
# v100-spool-sync-test — hermetic: the public-agent user, the spool, the GPU host and the job user are
# all local stubs (plain `env`, a bash -c "remote", temp dirs). No sudo, no ssh, no network.
set -u
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
sync=$here/v100-spool-sync
tmp=$(mktemp -d "${TMPDIR:-/tmp}/v100-sync-test.XXXXXX"); trap 'chmod -R u+rwX "$tmp" 2>/dev/null; rm -rf "$tmp"' EXIT
fails=0
check() { if [ "$2" = "$3" ]; then echo "PASS  $1"; else echo "FAIL  $1: got '$2' want '$3'"; fails=1; fi; }
yn() { if "$@" 2>/dev/null; then echo y; else echo n; fi; }
exists() { yn test -e "$1"; }
isfile() { yn test -f "$1" -a ! -L "$1"; }
reason() { cat "$1/REASON" 2>/dev/null | head -c 200; }

spool=$tmp/spool q=$tmp/q work=$tmp/work arch=$tmp/arch
mkdir -p "$spool"/{ready,done,failed} "$q"/{ready,running,done,failed} "$work"

# stubs: the "remote" logs "<script tag> <command>" and can inject faults; the job-user prefix logs its argv
# and can fail like a broken sudo. Fault knobs (env): REM_FAIL_TAG + REM_FAIL_MODE=before|after (exit 255; after
# = "lost ack"), REM_TRUNC_TAG + REM_TRUNC_BYTES (cut the stdin stream), REM_OUT_TAG + REM_OUT_VAL (fake stdout),
# REM_TEE=file (record the result stream the remote managed to emit before the caller hung up),
# REM_CAT_TAG + REM_CAT_FILE (replace that script's stdout with a crafted file), JOB_KILL_AFTER_MV (SIGKILL the remote
# script right after it moved the incoming dir into place: no trap runs, like a real kill),
# JOB_STAMP_FAIL (the stamp read prints nothing, like a failed sudo), JOB_SUDO_FAIL, JOB_PROBE_FAIL=1|empty (only the yes/no probes fail, or print nothing), JOB_DU_EMPTY, DU_LIE, JOB_FAIL_TAR (extract dies).
cat >"$tmp/remstub" <<'EOF'
#!/bin/bash
b=$(printf %s "$1" | sed -n 's/.*echo \([A-Za-z0-9+\/=]*\) | base64 -d.*/\1/p')
tag=$(printf %s "$b" | base64 -d | sed -n '1s/^#//p')
echo "$tag $1" >>"$REM_LOG"
echo $(ls -d "$TMPDIR"/v100-sync.*/j.* 2>/dev/null | wc -l) >>"$J_LOG"
if [ "$tag" = "${REM_OUT_TAG:-}" ]; then echo "$REM_OUT_VAL"; exit 0; fi
if [ "$tag" = "${REM_CAT_TAG:-}" ]; then cat "$REM_CAT_FILE"; exit 0; fi
if [ "$tag" = "${REM_FAIL_TAG:-}" ] && [ "${REM_FAIL_MODE:-}" = before ]; then exit 255; fi
if [ "$tag" = "${REM_TRUNC_TAG:-}" ]; then head -c "$REM_TRUNC_BYTES" | bash -c "$1"; exit $?; fi
if [ "$tag" = work ] && [ -n "${REM_TEE:-}" ]; then bash -c "$1" | tee "$REM_TEE"; exit 0; fi
bash -c "$1"; rc=$?
if [ "$tag" = "${REM_FAIL_TAG:-}" ]; then exit 255; fi
exit $rc
EOF
cat >"$tmp/jobrun" <<'EOF'
#!/bin/sh
echo "$*" >>"$STUB_LOG"
[ -z "${JOB_SUDO_FAIL:-}" ] || exit 1
if [ -n "${JOB_PROBE_FAIL:-}" ] && [ "$1" = sh ]; then case "${3:-}" in "[ -e"*) [ "$JOB_PROBE_FAIL" = empty ] && exit 0; exit 1 ;; esac; fi
if [ "$1" = mv ] && [ -n "${JOB_KILL_AFTER_MV:-}" ]; then case "$*" in *.incoming-*) "$@"; kill -9 $PPID; exit 137 ;; esac; fi
if [ "$1" = sh ] && [ -n "${JOB_STAMP_FAIL:-}" ]; then case "${3:-}" in "if [ -f"*) exit 0 ;; esac; fi
if [ "$1" = du ] && [ -n "${JOB_DU_EMPTY:-}" ]; then exit 0; fi
if [ "$1" = du ] && [ -n "${DU_LIE:-}" ]; then for a; do :; done; printf '1\t%s\n' "$a"; exit 0; fi
if [ "$1" = tar ] && [ -n "${JOB_FAIL_TAR:-}" ]; then case " $* " in *" -xf "*) "$@"; exit 137 ;; esac; fi
exec "$@"
EOF
# after the agent-side tar finishes, mutate the spool dir the way a hostile agent would
cat >"$tmp/pubtoctou" <<'EOF'
#!/bin/sh
"$@"; rc=$?
if [ "$1" = tar ]; then
  for a; do last=$a; done
  d=$SPOOL/ready/$last
  if [ -f "$d/run.sh" ] && [ ! -L "$d/run.sh" ]; then ln -sf /etc/passwd "$d/run.sh.n" && mv -f "$d/run.sh.n" "$d/run.sh"; ln -s /etc/passwd "$d/evil"; fi
  if [ -L "$d/planted" ]; then unlink "$d/planted"; fi
fi
exit $rc
EOF
# the agent-side extract of a result dies (a result that can never be delivered)
printf '#!/bin/sh\ncase " $* " in *" -xf "*) exit 2 ;; esac\nexec "$@"\n' >"$tmp/pubfailx"
chmod +x "$tmp/remstub" "$tmp/jobrun" "$tmp/pubtoctou" "$tmp/pubfailx"

# tick [VAR=val ...]: one sync tick, prints its exit code; runs in $tmp so an injected `touch PWNED` lands there
tick() {
  mkdir -p "$tmp/st"
  cd "$tmp" && env PUB_RUN=env SPOOL="$spool" REMOTE="$tmp/remstub" V100JOB_RUN="$tmp/jobrun" V100_Q="$q" \
    V100_WORK="$work" V100_ARCHIVE="$arch" STUB_LOG="$tmp/job.log" REM_LOG="$tmp/rem.log" J_LOG="$tmp/jcount.log" \
    TMPDIR="$tmp/st" V100_STATE="$tmp/state" "$@" "$sync" 2>"$tmp/err"
  echo $?
}
remcalls() { grep -c "^$1 " "$tmp/rem.log"; }
mkjob() { mkdir -p "$spool/ready/$1"; printf '#!/bin/sh\necho hi\n' >"$spool/ready/$1/run.sh"; }
# finished STATE NAME: a runner-finished token + payload on the "remote"
finished() { mkdir -p "$q/$1/3-rnd-$2" "$work/3-rnd-$2"; echo "log-$2" >"$q/$1/3-rnd-$2/job.log"; echo "out-$2" >"$work/3-rnd-$2/out.txt"; }

# ---- tick 1: good jobs plus every kind of bad one
mkjob good2
mkjob good; echo data >"$spool/ready/good/in.txt"; mkdir "$spool/ready/good/sub"; echo deep >"$spool/ready/good/sub/f"
long=$(printf 'a%.0s' $(seq 42))
for n in A a_b -x "a b" "$long" 'x;touch PWNED' 'y$(touch PWNED2)'; do mkjob "$n"; done
mkjob .hidden
mkjob sym; ln -s /etc/passwd "$spool/ready/sym/link"
mkjob fifo; mkfifo "$spool/ready/fifo/pipe"
mkjob big; truncate -s 51M "$spool/ready/big/blob"
mkjob huge; truncate -s 70M "$spool/ready/huge/blob"
mkdir "$spool/ready/norun"; echo x >"$spool/ready/norun/readme"
mkjob dup; mkdir -p "$work/3-rnd-dup"; echo mine >"$work/3-rnd-dup/marker"
mkdir "$tmp/elsewhere"; ln -s "$tmp/elsewhere" "$spool/ready/lnk"   # a top-level symlink entry, not a dir
check "tick 1 exit" "$(tick)" 0

check "good: work dir has run.sh"      "$(isfile "$work/3-rnd-good/run.sh")" y
check "good: work dir has input"       "$(cat "$work/3-rnd-good/in.txt" 2>/dev/null)" data
check "good: work dir nested file"     "$(cat "$work/3-rnd-good/sub/f" 2>/dev/null)" deep
check "good: queue token exists"       "$(isfile "$q/ready/3-rnd-good/run.sh")" y
check "good: token run.sh is a stub"   "$(cat "$q/ready/3-rnd-good/run.sh" 2>/dev/null)" 'echo "3-rnd token: payload runs from the v100job work dir" >&2; exit 1'
check "good: token carries a sha"      "$(grep -c '^[0-9a-f]\{64\}$' "$q/ready/3-rnd-good/.sha")" 1
check "good: sha not in the work dir"  "$(exists "$work/3-rnd-good/.sha")" n
check "good: no hidden token left"     "$(exists "$q/ready/.3-rnd-good")" n
check "good: no incoming dir/tar left" "$(exists "$work/.incoming-good")$(exists "$work/.incoming-good.tar")" nn
check "good: moved out of ready"       "$(exists "$spool/ready/good")" n
check "good: moved aside, not lost"    "$(exists "$spool/ready/.submitted-good/run.sh")" y
check "good: job-user prefix used"     "$(grep -c -e '--no-same-owner --no-same-permissions' "$tmp/job.log")" 2
check "good: extract ran under prefix" "$(grep -c 'tar -C [^ ]*incoming-good --no' "$tmp/job.log")" 1
check "stage: a finished job's stage is deleted before the next" "$(sort -n "$tmp/jcount.log" | tail -n1)" 1

for n in A a_b -x "a b" "$long"; do
  check "bad name rejected: ${n:0:12}" "$(reason "$spool/failed/$n" | grep -c 'name must match')" 1
  check "bad name not submitted: ${n:0:12}" "$(exists "$work/3-rnd-$n")" n
done
check "injection name (;) rejected"    "$(reason "$spool/failed/x;touch PWNED" | grep -c 'name must match')" 1
check "injection name (\$()) rejected" "$(reason "$spool/failed/y\$(touch PWNED2)" | grep -c 'name must match')" 1
check "injection never ran"            "$(exists "$tmp/PWNED")$(exists "$tmp/PWNED2")" nn
check "bad name never reached remote"  "$(grep -c PWNED "$tmp/rem.log")" 0
check "dot-name ignored"               "$(isfile "$spool/ready/.hidden/run.sh")" y
check "dot-name not submitted"         "$(exists "$work/3-rnd-.hidden")$(exists "$work/3-rnd-hidden")" nn
check "symlink in job -> failed"       "$(reason "$spool/failed/sym" | grep -c 'symlink')" 1
check "fifo in job -> failed"          "$(reason "$spool/failed/fifo" | grep -c 'fifo')" 1
check ">50MB -> failed"                "$(reason "$spool/failed/big" | grep -c '50 MB')" 1
check ">50MB+overhead -> failed"       "$(reason "$spool/failed/huge" | grep -c '50 MB')" 1
check "no run.sh -> failed"            "$(reason "$spool/failed/norun" | grep -c 'run.sh missing')" 1
check "top-level symlink -> failed"    "$(reason "$spool/failed/lnk" | grep -c 'name must match\|not a directory\|symlink')" 1
check "top-level symlink not followed" "$(ls "$tmp/elsewhere" | wc -l)" 0
check "duplicate -> failed"            "$(reason "$spool/failed/dup" | grep -c 'duplicate')" 1
check "duplicate: existing work kept"  "$(cat "$work/3-rnd-dup/marker")" mine
check "duplicate: no token made"       "$(exists "$q/ready/3-rnd-dup")" n
for n in sym fifo big huge norun dup; do check "rejected not submitted: $n" "$(exists "$work/3-rnd-$n")$(exists "$q/ready/3-rnd-$n")" "$([ $n = dup ] && echo yn || echo nn)"; done
check "rejected left ready"            "$(ls -A "$spool/ready" | grep -v '^\.' | wc -l)" 0

# ---- tick 2: nothing resubmits
cp -a "$work" "$tmp/work.snap"; : >"$tmp/rem.log"
check "tick 2 exit" "$(tick)" 0
check "tick 2 submits nothing"         "$(grep -c submitted "$tmp/err")" 0
check "tick 2 remote untouched"        "$(diff -r "$work" "$tmp/work.snap" >/dev/null && echo same)" same
check "tick 2 no remote submit call"   "$(remcalls submit)" 0

# ---- tick 3: validation reads the STAGED copy, not the spool the agent can still mutate
mkjob race1                                   # valid when copied; spool turned hostile right after
mkjob race2; ln -s /etc/passwd "$spool/ready/race2/planted"   # hostile when copied; spool cleaned right after
check "tick 3 exit" "$(tick PUB_RUN="$tmp/pubtoctou")" 0
check "toctou: valid-at-copy accepted"  "$(isfile "$work/3-rnd-race1/run.sh")" y
check "toctou: shipped the staged bytes" "$(tail -n1 "$work/3-rnd-race1/run.sh" 2>/dev/null)" "echo hi"
check "toctou: later mutation not shipped" "$(exists "$work/3-rnd-race1/evil")" n
check "toctou: token is the stub"       "$(grep -c 'payload runs from the v100job work dir' "$q/ready/3-rnd-race1/run.sh")" 1
check "toctou: hostile-at-copy rejected" "$(reason "$spool/failed/race2" | grep -c 'symlink')" 1
check "toctou: hostile-at-copy not shipped" "$(exists "$work/3-rnd-race2")" n

# ---- tick 4: results. good ran (runner moved its token to done/), plus a failed job and an oversized one
mv "$q/ready/3-rnd-good" "$q/done/3-rnd-good"; echo token-log >"$q/done/3-rnd-good/job.log"
echo result >"$work/3-rnd-good/out.txt"
mkdir -p "$q/failed/3-rnd-r2" "$work/3-rnd-r2"; echo token-log >"$q/failed/3-rnd-r2/job.log"; echo work-log >"$work/3-rnd-r2/job.log"; echo x >"$work/3-rnd-r2/ck.pt"
mkdir -p "$q/done/3-rnd-r3" "$work/3-rnd-r3"; echo biglog >"$q/done/3-rnd-r3/job.log"; truncate -s 201M "$work/3-rnd-r3/big.bin"; echo x >"$work/3-rnd-r3/small"
mkdir -p "$q/done/3-rnd-BAD"; echo x >"$q/done/3-rnd-BAD/job.log"
mkdir -p "$q/ready/3-rnd-pending"                         # not finished: must not be touched
check "tick 4 exit" "$(tick)" 0
check "result: output back in spool"   "$(cat "$spool/done/good/work/out.txt" 2>/dev/null)" result
check "result: work files back"        "$(isfile "$spool/done/good/work/in.txt")" y
check "result: top level is only ours" "$(ls -A "$spool/done/good" | LC_ALL=C sort | tr '\n' ' ')" ".v100-delivered job.log work "
check "result: job.log is the token log" "$(cat "$spool/done/good/job.log" 2>/dev/null)" token-log
check "result: failed state mirrored"  "$(cat "$spool/failed/r2/job.log" 2>/dev/null)" token-log
check "result: failed work files back" "$(isfile "$spool/failed/r2/work/ck.pt")" y
check "result: token to collected"     "$(isfile "$q/collected/3-rnd-good/job.log")" y
check "result: token left done/"       "$(exists "$q/done/3-rnd-good")" n
check "result: work to archive"        "$(cat "$arch/3-rnd-good/out.txt" 2>/dev/null)" result
check "result: work left work/"        "$(exists "$work/3-rnd-good")" n
check "result: failed token collected" "$(exists "$q/collected/3-rnd-r2/job.log")$(exists "$q/failed/3-rnd-r2")" yn
check ">200MB: log only"               "$(cat "$spool/done/r3/job.log" 2>/dev/null)" biglog
check ">200MB: TRUNCATED note"         "$(grep -c '200 MB' "$spool/done/r3/TRUNCATED" 2>/dev/null)" 1
check ">200MB: big file not copied"    "$(exists "$spool/done/r3/work/big.bin")$(exists "$spool/done/r3/work/small")$(exists "$spool/done/r3/work")" nnn
check ">200MB: still retired"          "$(exists "$arch/3-rnd-r3/big.bin")$(exists "$q/collected/3-rnd-r3")" yy
check "bad result name ignored"        "$(exists "$q/done/3-rnd-BAD")$(exists "$spool/done/BAD")" yn
check "unfinished token untouched"     "$(exists "$q/ready/3-rnd-pending")" y
check "no leftover hidden result dirs" "$(ls -A "$spool/done" "$spool/failed" | grep -c '^\.dest-tmp')" 0

# ---- tick 5: nothing is collected twice
find "$spool" "$q" "$arch" | sort >"$tmp/tree1"
check "tick 5 exit" "$(tick)" 0
find "$spool" "$q" "$arch" | sort >"$tmp/tree2"
check "tick 5 collects nothing"        "$(grep -c collected "$tmp/err")" 0
check "tick 5 tree unchanged"          "$(cmp -s "$tmp/tree1" "$tmp/tree2" && echo same)" same
check "no duplicate result dirs"       "$(ls "$spool/done" "$spool/failed" | grep -c '\.[0-9]\+$')" 0

# ---- lost submit ack: the remote finished the submit but the caller saw 255
mkjob ack; echo one >"$spool/ready/ack/x"
check "lost ack: tick exits nonzero"   "$(tick REM_FAIL_TAG=submit REM_FAIL_MODE=after)" 1
check "lost ack: remote did submit"    "$(isfile "$work/3-rnd-ack/run.sh")$(isfile "$q/ready/3-rnd-ack/.sha")" yy
check "lost ack: job kept in ready"    "$(exists "$spool/ready/ack/run.sh")" y
: >"$tmp/rem.log"
check "lost ack: next tick exit"       "$(tick)" 0
check "lost ack: moved aside, not failed" "$(exists "$spool/ready/.submitted-ack/run.sh")$(exists "$spool/failed/ack")$(exists "$spool/ready/ack")" ynn
check "lost ack: not submitted twice"  "$(remcalls submit)" 0
check "lost ack: recognised as submitted" "$(grep -c 'already submitted' "$tmp/err")" 1
mkjob ack; echo two >"$spool/ready/ack/x"                       # same name, DIFFERENT content: a real duplicate
check "changed content: tick exit"     "$(tick)" 0
check "changed content rejected as duplicate" "$(reason "$spool/failed/ack" | grep -c duplicate)" 1
check "changed content: token untouched" "$(isfile "$q/ready/3-rnd-ack/.sha")" y

# the dup check looks in every queue state: same sha = already submitted, other sha = duplicate
mkjob seed; echo q >"$spool/ready/seed/x"; cp -a "$spool/ready/seed" "$tmp/seed.orig"
check "dup states: seed submit exit"   "$(tick)" 0
sha=$(cat "$q/ready/3-rnd-seed/.sha")
for s in ready running done failed collected; do
  mkdir -p "$q/$s/3-rnd-same$s" "$q/$s/3-rnd-diff$s"
  printf %s "$sha" >"$q/$s/3-rnd-same$s/.sha"; printf %s deadbeef >"$q/$s/3-rnd-diff$s/.sha"
  cp -a "$tmp/seed.orig" "$spool/ready/same$s"; cp -a "$tmp/seed.orig" "$spool/ready/diff$s"
done
: >"$tmp/rem.log"
check "dup states: tick exit"          "$(tick)" 0
for s in ready running done failed collected; do
  check "dup state $s: same sha = already submitted" "$(exists "$spool/ready/.submitted-same$s")$(exists "$spool/failed/same$s/REASON")$(exists "$work/3-rnd-same$s")" ynn
  check "dup state $s: other sha = duplicate" "$(reason "$spool/failed/diff$s" | grep -c duplicate)" 1
done
check "dup states: same sha not resubmitted" "$(remcalls submit)" 0

# ---- failed or truncated submits leave nothing behind and retry cleanly
mkjob killx
check "killed extract: tick exits nonzero" "$(tick JOB_FAIL_TAR=1)" 1
check "killed extract: no remote residue" "$(exists "$work/3-rnd-killx")$(exists "$work/.incoming-killx")$(exists "$work/.incoming-killx.tar")$(exists "$q/ready/3-rnd-killx")$(exists "$q/ready/.3-rnd-killx")" nnnnn
check "killed extract: job kept for retry" "$(exists "$spool/ready/killx/run.sh")" y
check "killed extract: retry succeeds" "$(tick)$(isfile "$q/ready/3-rnd-killx/.sha")" 0y

mkjob trunc
check "truncated stream: tick exits nonzero" "$(tick REM_TRUNC_TAG=submit REM_TRUNC_BYTES=5120)" 1
check "truncated stream: nothing extracted" "$(exists "$work/3-rnd-trunc")$(exists "$work/.incoming-trunc")$(exists "$work/.incoming-trunc.tar")$(exists "$q/ready/3-rnd-trunc")" nnnn
check "truncated stream: job kept for retry" "$(exists "$spool/ready/trunc/run.sh")" y
check "truncated stream: retry succeeds" "$(tick)$(isfile "$q/ready/3-rnd-trunc/.sha")" 0y

mkjob stale; mkdir -p "$q/ready/.3-rnd-stale"; echo junk >"$q/ready/.3-rnd-stale/old"   # a dead earlier tick
check "stale hidden token: tick exit"  "$(tick)" 0
check "stale hidden token: submitted anyway" "$(isfile "$q/ready/3-rnd-stale/.sha")$(exists "$q/ready/3-rnd-stale/old")" yn

# ---- a failed sudo must never read as "absent", and a bad probe must never retire anything
mkjob sf
finished done sfr
: >"$tmp/rem.log"
check "sudo fail: tick exits nonzero"  "$(tick JOB_SUDO_FAIL=1)" 1
check "sudo fail: never reached submit" "$(remcalls submit)" 0
check "sudo fail: submit retried, not rejected" "$(exists "$spool/ready/sf/run.sh")$(exists "$spool/failed/sf")$(exists "$work/3-rnd-sf")" ynn
check "sudo fail: result not retired"  "$(exists "$q/done/3-rnd-sfr/job.log")$(exists "$work/3-rnd-sfr/out.txt")$(exists "$spool/done/sfr")" yyn
finished done fz
check "retire fails (setup): exit" "$(tick REM_FAIL_TAG=final REM_FAIL_MODE=before)" 1
mkjob pf; mkdir -p "$work/3-rnd-pf"; echo theirs >"$work/3-rnd-pf/keep"   # a job-private dir we can only see via a probe
: >"$tmp/rem.log"
check "probe fail: tick exits nonzero" "$(tick JOB_PROBE_FAIL=1)" 1
check "probe fail: dup check retried, not 'free'" "$(remcalls submit)$(exists "$spool/ready/pf/run.sh")$(exists "$spool/failed/pf")" 0yn
check "probe fail: foreign dir untouched" "$(cat "$work/3-rnd-pf/keep")" theirs
check "probe fail: retire not done on a failed probe" "$(exists "$q/done/3-rnd-fz")$(exists "$work/3-rnd-fz/out.txt")$(exists "$q/collected/3-rnd-fz")" yyn
check "probe fail: recovery"           "$(tick)" 0
check "probe fail: recovered dup is a duplicate" "$(reason "$spool/failed/pf" | grep -c duplicate)" 1
check "probe fail: recovered retire"   "$(exists "$q/done/3-rnd-fz")$(exists "$q/collected/3-rnd-fz")" ny
finished done fz2
check "retire fails (setup 2): exit"   "$(tick REM_FAIL_TAG=final REM_FAIL_MODE=before)" 1
check "empty probe: tick exits nonzero" "$(tick JOB_PROBE_FAIL=empty)" 1
check "empty probe: not read as absent" "$(exists "$q/done/3-rnd-fz2")$(exists "$work/3-rnd-fz2/out.txt")$(exists "$q/collected/3-rnd-fz2")" yyn
check "empty probe: recovery"          "$(tick)$(exists "$q/done/3-rnd-fz2")$(exists "$q/collected/3-rnd-fz2")" 0ny
finished done duq
check "empty du: tick exits nonzero"   "$(tick JOB_DU_EMPTY=1)" 1
check "empty du: not treated as big"   "$(exists "$spool/done/duq")$(exists "$q/done/3-rnd-duq")" ny
finished done um
check "unknown size mode: tick exits nonzero" "$(tick REM_OUT_TAG=prep REM_OUT_VAL=garbage)" 1
check "unknown size mode: never retired" "$(exists "$spool/done/um")$(exists "$q/done/3-rnd-um")$(exists "$work/3-rnd-um")" nyy
check "recovery: tick exit"            "$(tick)" 0
check "recovery: submit happened"      "$(isfile "$q/ready/3-rnd-sf/.sha")" y
check "recovery: results delivered"    "$(cat "$spool/done/sfr/work/out.txt")$(cat "$spool/done/duq/work/out.txt")$(cat "$spool/done/um/work/out.txt")" out-sfrout-duqout-um
check "recovery: results retired"      "$(exists "$q/collected/3-rnd-sfr")$(exists "$q/collected/3-rnd-duq")$(exists "$q/collected/3-rnd-um")" yyy

# ---- delivery is idempotent and atomic; never timestamped copies
finished done fin
check "retire fails: tick exits nonzero" "$(tick REM_FAIL_TAG=final REM_FAIL_MODE=before)" 1
check "retire fails: result delivered with marker" "$(cat "$spool/done/fin/work/out.txt")$(exists "$spool/done/fin/.v100-delivered")" out-finy
check "retire fails: token still queued" "$(exists "$q/done/3-rnd-fin")" y
check "retire retry: tick exit"        "$(tick)" 0
check "retire retry: no second copy"   "$(ls "$spool/done" | grep -c '^fin')" 1
check "retire retry: retired"          "$(exists "$q/done/3-rnd-fin")$(exists "$q/collected/3-rnd-fin")" ny
mkdir -p "$spool/done/.dest-tmp-y"; echo junk >"$spool/done/.dest-tmp-y/junk"   # a dead earlier delivery
finished done y
check "stale temp dir: tick exit"      "$(tick)" 0
check "stale temp dir: clean delivery" "$(cat "$spool/done/y/work/out.txt")$(exists "$spool/done/y/junk")$(exists "$spool/done/.dest-tmp-y")" out-ynn
mkdir -p "$q/failed/3-rnd-dup"; echo duplog >"$q/failed/3-rnd-dup/job.log"   # failed/dup already holds a REASON dir
check "name collision: tick exit"      "$(tick)" 0
check "name collision: earlier dir untouched" "$(reason "$spool/failed/dup" | grep -c duplicate)" 1
check "name collision: result next to it" "$(cat "$spool/failed/dup.2/job.log" 2>/dev/null)" duplog

# ---- result caps
finished done cap; truncate -s 4M "$work/3-rnd-cap/big.bin"
check "stream cap: tick exit"          "$(tick DU_LIE=1 V100_OUTMAX=1000000 REM_TEE="$tmp/tee.out")" 0
check "stream cap: stops reading at the cap" "$([ "$(stat -c %s "$tmp/tee.out")" -lt 3000000 ] && echo y)" y
check "stream cap: TRUNCATED"          "$(grep -c 'size cap' "$spool/done/cap/TRUNCATED" 2>/dev/null)" 1
check "stream cap: log only"           "$(cat "$spool/done/cap/job.log")$(exists "$spool/done/cap/work/big.bin")$(exists "$spool/done/cap/work/out.txt")" log-capnn
check "stream cap: still retired"      "$(exists "$q/collected/3-rnd-cap")$(exists "$arch/3-rnd-cap/big.bin")" yy
finished done many; for i in $(seq 20); do echo "$i" >"$work/3-rnd-many/f$i"; done
check "file cap: tick exit"            "$(tick V100_MAXFILES=10)" 0
check "file cap: TRUNCATED"            "$(grep -c 'files' "$spool/done/many/TRUNCATED" 2>/dev/null)" 1
check "file cap: log only"             "$(cat "$spool/done/many/job.log")$(exists "$spool/done/many/work/f1")" log-manyn

# ---- review 2, item 1: a hostile result tar cannot write outside work/ nor redirect the operator's writes
mkdir "$tmp/vdir" "$tmp/h1" "$tmp/h2a" "$tmp/h2b/d" "$tmp/h3" "$tmp/h5"
ln -s "$tmp/victim" "$tmp/h1/job.log"; tar -C "$tmp/h1" -cf "$tmp/h1.tar" job.log                        # symlink job.log
ln -s "$tmp/vdir" "$tmp/h2a/d"; echo x >"$tmp/h2b/d/pwn"                                                  # symlink, then a member through it
tar -C "$tmp/h2a" -cf "$tmp/h2.tar" d; tar -C "$tmp/h2b" -cf "$tmp/h2b.tar" d/pwn; tar -Af "$tmp/h2.tar" "$tmp/h2b.tar"
echo x >"$tmp/h3/escape"; tar -C "$tmp/h3" -cf "$tmp/h3.tar" --transform='s,^,../,' escape                  # ../ member
tar -C "$tmp/h3" -cPf "$tmp/h4.tar" --transform="s,^,$tmp/abs-," escape                                     # absolute member
echo a >"$tmp/h5/a"; ln "$tmp/h5/a" "$tmp/h5/b"; tar -C "$tmp/h5" -cf "$tmp/h5.tar" a b                    # hardlink
for h in h1 h2 h3 h4 h5; do
  finished done $h
  check "hostile $h: tick exit"          "$(tick REM_CAT_TAG=work REM_CAT_FILE="$tmp/$h.tar")" 0
  check "hostile $h: nothing extracted"  "$(exists "$spool/done/$h/work")" n
  check "hostile $h: degraded with a note" "$(grep -c 'rejected' "$spool/done/$h/TRUNCATED" 2>/dev/null)" 1
  check "hostile $h: log still delivered" "$(cat "$spool/done/$h/job.log" 2>/dev/null)" "log-$h"
  check "hostile $h: top level is only ours" "$(ls -A "$spool/done/$h" | LC_ALL=C sort | tr '\n' ' ')" ".v100-delivered TRUNCATED job.log "
  check "hostile $h: retired"            "$(exists "$q/collected/3-rnd-$h")$(exists "$q/done/3-rnd-$h")" yn
done
check "hostile: nothing written outside" "$(exists "$tmp/victim")$(exists "$tmp/vdir/pwn")$(exists "$tmp/abs-escape")$(exists "$spool/done/h3/escape")$(exists "$spool/escape")" nnnnn

# ---- item 2: a result that can never be collected degrades after 3 failed attempts; a dead log gives up after 10
finished done px
for k in 1 2; do
  check "poison extract: tick $k exits nonzero" "$(tick PUB_RUN="$tmp/pubfailx")" 1
  check "poison extract: tick $k delivers nothing, leaves no temp" "$(exists "$spool/done/px")$(exists "$spool/done/.dest-tmp-px")$(exists "$q/done/3-rnd-px")" nny
done
check "poison extract: tick 3 exits nonzero (loud)" "$(tick PUB_RUN="$tmp/pubfailx")" 1
check "poison extract: tick 3 delivers job.log only" "$(cat "$spool/done/px/job.log")$(exists "$spool/done/px/work")$(grep -c '3x' "$spool/done/px/TRUNCATED")" log-pxn1
check "poison extract: retired within 3 ticks" "$(exists "$q/collected/3-rnd-px")$(exists "$q/done/3-rnd-px")$(exists "$tmp/state/done.px")" ynn
check "poison extract: one loud line" "$(grep -c 'delivering job.log only' "$tmp/err")" 1
: >"$tmp/rem.log"
check "poison extract: tick 4 quiet"   "$(tick PUB_RUN="$tmp/pubfailx")$(remcalls work)" 00
finished failed pd
for k in 1 2; do check "poison du: tick $k exits nonzero" "$(tick JOB_DU_EMPTY=1)$(exists "$spool/failed/pd")" 1n; done
check "poison du: tick 3 exits nonzero (loud)" "$(tick JOB_DU_EMPTY=1)" 1
check "poison du: log only, retired"   "$(cat "$spool/failed/pd/job.log")$(exists "$spool/failed/pd/work")$(exists "$q/collected/3-rnd-pd")" log-pdny
finished done lg
for k in 1 2 3 4 5 6 7 8 9; do
  check "dead log: tick $k exits nonzero, no delivery" "$(tick REM_FAIL_TAG=log REM_FAIL_MODE=before)$(exists "$spool/done/lg")$(exists "$q/collected/3-rnd-lg")" 1nn
done
check "dead log: tick 10 gives up, loud"  "$(tick REM_FAIL_TAG=log REM_FAIL_MODE=before)" 1
check "dead log: empty job.log + both notes, no work retried" "$(wc -c <"$spool/done/lg/job.log")$(grep -c "collect failed 10x" "$spool/done/lg/TRUNCATED")$(grep -c "work collect failed 3x" "$spool/done/lg/TRUNCATED")$(exists "$spool/done/lg/work")" 011n
check "dead log: retired, counter gone"   "$(exists "$q/collected/3-rnd-lg")$(exists "$q/done/3-rnd-lg")$(exists "$tmp/state/done.lg")" ynn
check "dead log: one loud line"           "$(grep -c 'delivering an empty job.log' "$tmp/err")" 1
check "dead log: tick 11 quiet"           "$(tick REM_FAIL_TAG=log REM_FAIL_MODE=before)" 0

# ---- item 3: killed between the work-dir move and the token: the next tick adopts the orphan instead of calling it a duplicate
mkjob orph; echo o >"$spool/ready/orph/x"
check "killed after move: tick exits nonzero" "$(tick JOB_KILL_AFTER_MV=1)" 1
check "killed after move: stranded work dir, no token" "$(isfile "$work/3-rnd-orph/.v100-submit-sha")$(exists "$q/ready/3-rnd-orph")$(exists "$q/ready/.3-rnd-orph")" ynn
check "killed after move: job kept in ready" "$(exists "$spool/ready/orph/run.sh")" y
check "orphan: retry exits 0"          "$(tick)" 0
check "orphan: not rejected as a duplicate" "$(exists "$spool/failed/orph")$(grep -c duplicate "$tmp/err")" n0
check "orphan: submitted fresh"        "$(isfile "$q/ready/3-rnd-orph/.sha")$(cat "$work/3-rnd-orph/x")$(exists "$spool/ready/.submitted-orph/run.sh")" yoy
mkjob ofor; mkdir -p "$work/3-rnd-ofor"; printf %s deadbeef >"$work/3-rnd-ofor/.v100-submit-sha"   # someone else's dir
check "foreign stamp: still a duplicate" "$(tick)$(reason "$spool/failed/ofor" | grep -c duplicate)" 01
check "foreign stamp: their dir untouched" "$(cat "$work/3-rnd-ofor/.v100-submit-sha")$(exists "$q/ready/3-rnd-ofor")" deadbeefn

mkjob osf; mkdir -p "$work/3-rnd-osf"; echo theirs >"$work/3-rnd-osf/keep"; : >"$tmp/rem.log"
check "stamp read fails: retried, not clobbered" "$(tick JOB_STAMP_FAIL=1)$(remcalls submit)$(exists "$spool/ready/osf/run.sh")$(exists "$spool/failed/osf")$(cat "$work/3-rnd-osf/keep")" 10yntheirs
# ---- item 4: the delivered marker is bound to the job's sha
S1=$(printf 'a%.0s' $(seq 64)); S2=$(printf 'b%.0s' $(seq 64))
finished done mk; printf %s "$S1" >"$q/done/3-rnd-mk/.sha"
mkdir -p "$spool/done/mk"; printf %s "$S2" >"$spool/done/mk/.v100-delivered"; echo theirs >"$spool/done/mk/job.log"   # another job's delivery
check "foreign marker: tick exit"      "$(tick)" 0
check "foreign marker: their result untouched" "$(cat "$spool/done/mk/job.log")" theirs
check "foreign marker: ours next to it" "$(cat "$spool/done/mk.2/job.log")$(cat "$spool/done/mk.2/.v100-delivered" | head -c 3)" log-mkaaa
check "foreign marker: retired"        "$(exists "$q/collected/3-rnd-mk")" y
finished done mk3; printf %s "$S1" >"$q/done/3-rnd-mk3/.sha"
check "own marker: retire fails, delivered" "$(tick REM_FAIL_TAG=final REM_FAIL_MODE=before)$(cat "$spool/done/mk3/.v100-delivered" | head -c 3)" 1aaa
check "own marker: retry does not redeliver" "$(tick)$(ls "$spool/done" | grep -c '^mk3')$(exists "$q/collected/3-rnd-mk3")" 01y

# ---- item 5: job.log that is not a regular file is never followed
echo SECRET >"$tmp/secret"
finished done lk; unlink "$q/done/3-rnd-lk/job.log"; ln -s "$tmp/secret" "$q/done/3-rnd-lk/job.log"
check "symlink job.log: tick exit"     "$(tick)" 0
check "symlink job.log: empty log, secret not read" "$(wc -c <"$spool/done/lk/job.log")$(grep -c SECRET "$spool/done/lk/job.log")" 00
check "symlink job.log: noted"         "$(grep -c 'not a regular file' "$spool/done/lk/TRUNCATED")" 1
check "symlink job.log: work still delivered, retired" "$(cat "$spool/done/lk/work/out.txt")$(exists "$q/collected/3-rnd-lk")" out-lky
finished done lkd; unlink "$q/done/3-rnd-lkd/job.log"; mkdir "$q/done/3-rnd-lkd/job.log"   # not a regular file either
check "dir job.log: tick exit, empty log, noted" "$(tick)$(wc -c <"$spool/done/lkd/job.log")$(grep -c 'not a regular file' "$spool/done/lkd/TRUNCATED")" 001

# ---- review 3, item 1: infra faults (job-user sudo down: the probe prints nothing) are never counted against the job
finished done inf
for k in 1 2 3 4 5; do
  check "infra fault: tick $k exits nonzero, nothing delivered, nothing counted" "$(tick JOB_PROBE_FAIL=empty)$(exists "$spool/done/inf")$(exists "$tmp/state/done.inf")" 1nn
done
check "infra fault: recovery delivers the work, not log-only" "$(tick)$(cat "$spool/done/inf/work/out.txt")$(exists "$spool/done/inf/TRUNCATED")" 0out-infn
finished done inf2
check "infra fault: ssh lost on the probe is not counted either" "$(tick REM_FAIL_TAG=prep REM_FAIL_MODE=before)$(exists "$tmp/state/done.inf2")" 1n
check "infra fault: and the retry delivers the work" "$(tick)$(cat "$spool/done/inf2/work/out.txt")" 0out-inf2

# ---- review 3, item 2: a partial extract that leaves a 0500 dir cannot wedge the result dir; every failure is counted
printf '#!/bin/sh\ncase " $* " in *" -xf "*) "$@"; exit 2 ;; esac\nexec "$@"\n' >"$tmp/pubpart"; chmod +x "$tmp/pubpart"
finished done pw; mkdir "$work/3-rnd-pw/d"; echo x >"$work/3-rnd-pw/d/f"; chmod 500 "$work/3-rnd-pw/d"
for k in 1 2; do
  check "partial extract: tick $k counted, no wedge, no temp left" "$(tick PUB_RUN="$tmp/pubpart")$(cat "$tmp/state/done.pw")$(ls -A "$spool/done" | grep -c '^\.dest-tmp-pw')" "1${k}0"
done
check "partial extract: tick 3 degrades to log only" "$(tick PUB_RUN="$tmp/pubpart")$(cat "$spool/done/pw/job.log")$(exists "$spool/done/pw/work")$(ls -A "$spool/done" | grep -c '^\.dest-tmp-pw')" 1log-pwn0
chmod -R u+rwX "$work" 2>/dev/null

# ---- review 3, item 3: a job that ships the reserved stamp name (here a directory) is rejected, not retried forever
mkjob stp; mkdir "$spool/ready/stp/.v100-submit-sha"; echo x >"$spool/ready/stp/.v100-submit-sha/f"
check "stamp-name dir: tick exits clean" "$(tick)" 0
check "stamp-name dir: rejected with a reason" "$(reason "$spool/failed/stp" | grep -c 'v100-submit-sha')" 1
check "stamp-name dir: not shipped, not left in ready" "$(exists "$work/3-rnd-stp")$(exists "$work/.incoming-stp")$(exists "$spool/ready/stp")" nnn
mkjob stf; printf deadbeef >"$spool/ready/stf/.v100-submit-sha"
check "stamp-name file: rejected too" "$(tick)$(reason "$spool/failed/stf" | grep -c 'v100-submit-sha')$(exists "$work/3-rnd-stf")" 01n

# ---- wb-4gf item 1: a job with a file the agent cannot read is rejected after 3 failed copies, not re-copied on every tick
mkjob unr; echo secret >"$spool/ready/unr/locked"; chmod 000 "$spool/ready/unr/locked"
for k in 1 2; do tick >/dev/null; done
check "unreadable file: copy failures 1-2 retry (still in ready, no reason)" "$(exists "$spool/ready/unr/run.sh")$(exists "$spool/failed/unr")" yn
check "unreadable file: tick 3 exits clean after rejecting" "$(tick)" 0
check "unreadable file: rejected with a REASON after 3 failed copies" "$(exists "$spool/ready/unr")$(reason "$spool/failed/unr" | grep -c 'copy failed 3 times')" n1
check "unreadable file: never shipped" "$(exists "$work/3-rnd-unr")$(exists "$q/ready/3-rnd-unr")" nn
chmod -R u+rwX "$spool/failed/unr" "$spool/ready/unr" 2>/dev/null; mv "$spool/ready/unr" "$tmp/unr.left" 2>/dev/null   # a still-stuck job must not fail later cases

# ---- review 3, item 4: an unreadable job.log is a read error (retried, then the 10x give-up), not a silent empty log
mkdir -p "$tmp/faketail"; printf '#!/bin/sh\necho "tail: cannot open job.log: Permission denied" >&2\nexit 1\n' >"$tmp/faketail/tail"; chmod +x "$tmp/faketail/tail"
finished done ul
check "unreadable log: tick 1 exits nonzero, not delivered" "$(tick PATH="$tmp/faketail:$PATH")$(exists "$spool/done/ul")$(cat "$tmp/state/done.ul")" 1n1
for k in 2 3 4 5 6 7 8 9; do tick PATH="$tmp/faketail:$PATH" >/dev/null; done
check "unreadable log: tick 10 gives up with an empty log + note" "$(tick PATH="$tmp/faketail:$PATH")$(wc -c <"$spool/done/ul/job.log")$(grep -c 'collect failed 10x' "$spool/done/ul/TRUNCATED")" 101
finished done ml; unlink "$q/done/3-rnd-ml/job.log"
check "missing log: still an empty log, clean" "$(tick)$(wc -c <"$spool/done/ml/job.log")" 00

# ---- review 3, item 5: a counter that cannot be written fails the tick loudly; sha-less tokens get distinct markers
finished done cw; mkdir -p "$tmp/state/done.cw"
check "counter write fails: loud, nothing delivered" "$(tick JOB_DU_EMPTY=1)$(grep -c 'cannot write attempt counter' "$tmp/err")$(exists "$spool/done/cw")$(ls -A "$spool/done" | grep -c '^\.dest-tmp-cw')" 11n0
rmdir "$tmp/state/done.cw"
finished done ns1; finished done ns2
check "sha-less tokens: tick exit" "$(tick)" 0
m1=$(cat "$spool/done/ns1/.v100-delivered"); m2=$(cat "$spool/done/ns2/.v100-delivered")
check "sha-less tokens: markers distinct, 64 hex" "$([ "$m1" != "$m2" ] && echo d)$(printf %s "$m1$m2" | grep -c '^[0-9a-f]\{128\}$')" d1

# ---- review 4: infra retries have a ceiling (a job can induce one, e.g. by killing its own tar), after which the degrade path is reachable
finished done ic
for k in $(seq 30); do tick REM_FAIL_TAG=prep REM_FAIL_MODE=before >/dev/null; done
check "infra ceiling: 30 infra ticks stay uncounted, nothing delivered" "$(cat "$tmp/state/done.ic.infra")$(exists "$tmp/state/done.ic")$(exists "$spool/done/ic")" 30nn
check "infra ceiling: tick 31 counts as a job fault (1/3)" "$(tick REM_FAIL_TAG=prep REM_FAIL_MODE=before)$(cat "$tmp/state/done.ic")$(exists "$spool/done/ic")" 11n
check "infra ceiling: tick 32 counts (2/3)" "$(tick REM_FAIL_TAG=prep REM_FAIL_MODE=before)$(cat "$tmp/state/done.ic")" 12
check "infra ceiling: tick 33 degrades to log only and retires" "$(tick REM_FAIL_TAG=prep REM_FAIL_MODE=before)$(cat "$spool/done/ic/job.log")$(exists "$spool/done/ic/work")$(grep -c 'work collect failed 3x' "$spool/done/ic/TRUNCATED")$(exists "$q/collected/3-rnd-ic")$(exists "$tmp/state/done.ic.infra")$(exists "$tmp/state/done.ic")" 1log-icn1ynn
finished done iw
for k in 1 2 3; do tick REM_FAIL_TAG=prep REM_FAIL_MODE=before >/dev/null; done
check "infra counter: cleared when the job is collected" "$(cat "$tmp/state/done.iw.infra")$(tick)$(exists "$tmp/state/done.iw.infra")$(cat "$spool/done/iw/work/out.txt")" 30nout-iw

# ---- the default REMOTE is bounded, and an unreachable remote is a nonzero exit
mkdir -p "$tmp/bin" "$tmp/emptyspool"
printf '#!/bin/sh\necho "$*" >>"$SSH_LOG"\nexit 255\n' >"$tmp/bin/ssh"; chmod +x "$tmp/bin/ssh"
rc=$(cd "$tmp" && env -u REMOTE PATH="$tmp/bin:$PATH" PUB_RUN=env SPOOL="$tmp/emptyspool" V100_STATE="$tmp/state" V100_HOST=gpu-host SSH_LOG="$tmp/ssh.log" "$sync" 2>"$tmp/err"; echo $?)
check "unreachable remote: exit nonzero" "$rc" 1
check "default ssh: BatchMode"         "$(grep -c 'BatchMode=yes' "$tmp/ssh.log")" 1
check "default ssh: ConnectTimeout"    "$(grep -c 'ConnectTimeout=10' "$tmp/ssh.log")" 1
check "default ssh: ServerAlive"       "$(grep -c 'ServerAliveInterval=15 -o ServerAliveCountMax=4' "$tmp/ssh.log")" 1
check "default ssh: host"              "$(grep -c ' gpu-host ' "$tmp/ssh.log")" 1

exit $fails
