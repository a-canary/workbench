#!/usr/bin/env bash
# v100-spool-sync — one tick of the public-agent -> GPU-host job spool. Run from cron under flock.
#   bin/v100-spool-sync       submit ready/<name> jobs, then collect finished results; exit 0 = clean tick,
#                             1 = the remote was unreachable or a job hit an error (it retries next tick), 2 = setup broken
# Trust boundary: the spool is written by an untrusted public agent. Jobs are copied out as that agent,
# VALIDATED ON THE STAGED COPY (the agent can mutate its spool dir mid-tick), and only then streamed to the
# GPU host, where they are checksum-verified and extracted as an unprivileged job user. The job name passes a
# strict regex before it reaches any path or remote command. Every external boundary is overridable by env
# (hermetic tests):
#   PUB_RUN        run-as-public-agent prefix        (default: sudo -n -u agent-pub)
#   SPOOL          spool root with ready|done|failed (default: <agent-pub home>/v100-spool)
#   REMOTE         remote exec prefix, 1 arg = shell string (default: ssh, bounded timeouts, host $V100_HOST)
#   V100JOB_RUN    remote-side run-as-job-user prefix (default: sudo -n -u v100job)
#   V100_Q         remote queue dir                  (default: remote ~/v100-jobs)
#   V100_WORK      remote job payload dir            (default: /var/lib/v100job/work)
#   V100_ARCHIVE   remote finished-payload dir       (default: /var/lib/v100job/archive)
#   V100_OUTMAX    result payload cap, bytes         (default: 200 MB)    V100_MAXFILES  result file cap (default 10000)
#   V100_STATE     per-job attempt counters          (default: ${XDG_STATE_HOME:-~/.local/state}/v100-spool-sync)
# Layout: spool ready/<name>/run.sh -> remote $V100_WORK/3-rnd-<name>/ + queue token $V100_Q/ready/3-rnd-<name>/.
# The 3-rnd- priority prefix is forced here, never chosen by the agent. Tools: GNU tar/find/du, base64, sha256sum.
# Idempotency: a submit is identified by the sha256 of the staged tar, stored in the token dir as .sha, so a lost
# ack is recognised next tick instead of being rejected as a duplicate. A result is delivered into a hidden
# temp dir and renamed into place with a marker holding the job's sha, so a retry after a failed retire never
# delivers twice. Result layout: <state>/<name>/{job.log,TRUNCATED,work/...}: the payload is extracted into work/
# only after the staged result tar passed the same safety check as a submit, so nothing a result tar carries can
# sit at, or redirect a write at, the top level the operator writes (job.log, TRUNCATED, marker).
# Poison results degrade instead of retrying forever: the 3rd failed collect delivers job.log only, the 10th gives
# up on the log too (empty job.log + note) and retires, one loud line each. Counters live in $V100_STATE.
# Only job-specific faults count. An infra fault (unreadable probe, job-user sudo down, ssh lost) retries uncounted, up to $V100_INFRATRIES (default 30)
# per job; the next one then counts as a job fault, so the degrade/retire path is always reachable (a job can induce one).
set -euo pipefail
export LC_ALL=C

log() { echo "v100-spool-sync: $*" >&2; }
die() { log "$*"; exit 2; }
errs=0
fail() { errs=1; log "$*"; }

PUB_RUN=${PUB_RUN:-sudo -n -u agent-pub}
V100JOB_RUN=${V100JOB_RUN:-sudo -n -u v100job}
REMOTE=${REMOTE:-ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4 ${V100_HOST:?set V100_HOST (or REMOTE)}}
V100_Q=${V100_Q:-}
V100_WORK=${V100_WORK:-/var/lib/v100job/work}
V100_ARCHIVE=${V100_ARCHIVE:-/var/lib/v100job/archive}
OUTMAX=${V100_OUTMAX:-209715200}
MAXFILES=${V100_MAXFILES:-10000}
STATE=${V100_STATE:-${XDG_STATE_HOME:-${HOME:?set V100_STATE or HOME}/.local/state}/v100-spool-sync}
WORKTRIES=3 LOGTRIES=10 INFRATRIES=${V100_INFRATRIES:-30}
if [ -z "${SPOOL:-}" ]; then
  h=$(getent passwd agent-pub | cut -d: -f6) || true
  [ -n "${h:-}" ] || die "SPOOL unset and no agent-pub home"
  SPOOL=$h/v100-spool
fi

NAME_RE='^[a-z0-9][a-z0-9-]{0,40}$'
MAXB=52428800                          # 50 MB staged job
CAPB=$((MAXB + 10485760))              # archive read cap: job + tar overhead, bounds the staging disk use
STREAMCAP=$((OUTMAX + OUTMAX / 20 + 1048576))   # result stream cap: payload + tar overhead
MARK=.v100-delivered
TOKEN_STUB='echo "3-rnd token: payload runs from the v100job work dir" >&2; exit 1'

pub() { $PUB_RUN "$@"; }      # intentional word-splitting: PUB_RUN is a command prefix
# rsh SCRIPT ARGS...: run SCRIPT on the remote as `bash -c`. The script travels base64 and every arg is
# %q-quoted, so no value is ever spliced into remote shell syntax. stdin passes through.
rsh() {
  local s=$1 b; shift
  b=$(printf %s "$s" | base64 -w0)
  $REMOTE "bash -c \"\$(echo $b | base64 -d)\" _ $(printf '%q ' "$V100JOB_RUN" "$V100_Q" "$V100_WORK" "$V100_ARCHIVE" "$@")"
}

# remote scripts: $1..$4 = RUN Q WORK ARCHIVE, then own args. Q defaults to the remote user's ~/v100-jobs.
# The first line is a tag. Probes read the job user's private dirs by OUTPUT (yes/no): a failed sudo yields
# empty output and exit 9, never a false "absent".
pre() { printf '#%s\nRUN=$1 Q=${2:-$HOME/v100-jobs} W=$3 A=$4; shift 4\n' "$1"; }
PROBE='$RUN sh -c '"'"'[ -e "$1" ] && echo yes || echo no'"'"' _'
R_DUP="$(pre dup)"'
n=3-rnd-$1 sha=$2
# exit 0 free | 1 taken by something else | 3 already submitted with this sha | 9 cannot tell
for s in ready running done failed collected; do
  if [ -e "$Q/$s/$n" ]; then
    if [ "$(cat "$Q/$s/$n/.sha" 2>/dev/null)" = "$sha" ]; then exit 3; fi
    exit 1
  fi
done
p=$('"$PROBE"' "$W/$n")
case $p in
  no) exit 0 ;;
  yes) # a work dir with no token anywhere: ours if it carries this sha (killed between the move and the token,
       # so nothing ran): drop it and let the submit start fresh; anything else is a real duplicate
       o=$($RUN sh -c '"'"'if [ -f "$1" ] && [ ! -L "$1" ]; then echo "s:$(cat "$1")"; else echo none; fi'"'"' _ "$W/$n/.v100-submit-sha")
       case $o in
         "s:$sha") $RUN rm -rf -- "$W/$n" || exit 9; exit 0 ;;
         none | s:*) exit 1 ;;
         *) exit 9 ;;
       esac ;;
  *) exit 9 ;;
esac'
R_SUBMIT="$(pre submit)"'
set -e
n=3-rnd-$1 sha=$2 i=$W/.incoming-$1 f=$W/.incoming-$1.tar moved= tok=
trap '"'"'$RUN rm -rf -- "$i" "$f"; [ -z "$moved" ] || $RUN rm -rf -- "$W/$n"; [ -z "$tok" ] || rm -rf -- "$Q/ready/.$n"'"'"' EXIT
$RUN rm -rf -- "$i" "$f"
rm -rf -- "$Q/ready/.$n"
$RUN mkdir -p -- "$W"
$RUN sh -c '"'"'cat >"$1"'"'"' _ "$f"
got=$($RUN sha256sum -- "$f"); got=${got%% *}
[ "$got" = "$sha" ] || { echo "stream sha mismatch" >&2; exit 1; }
$RUN mkdir -- "$i"
$RUN tar -C "$i" --no-same-owner --no-same-permissions -xf "$f"
$RUN rm -f -- "$f"
$RUN sh -c '"'"'printf %s "$1" >"$2"'"'"' _ "$sha" "$i/.v100-submit-sha"
$RUN mv -T -- "$i" "$W/$n"; moved=1
mkdir -p -- "$Q/ready"
mkdir -- "$Q/ready/.$n"; tok=1
printf "%s\n" "$3" >"$Q/ready/.$n/run.sh"
printf %s "$sha" >"$Q/ready/.$n/.sha"
mv -T -- "$Q/ready/.$n" "$Q/ready/$n"; moved= tok='
R_LIST="$(pre list)"'
for s in done failed; do for d in "$Q/$s"/3-rnd-*; do
  [ -d "$d" ] && [ ! -L "$d" ] || continue
  x=; if [ -f "$d/.sha" ] && [ ! -L "$d/.sha" ]; then x=$(head -c 64 "$d/.sha" | tr -dc 0-9a-f); fi
  # no usable sha: a stable per-token id (inode+mtime), so a retry recognises its own delivery and two tokens never share one
  [ "${#x}" = 64 ] || x=$(stat -c %i-%Y "$d" | sha256sum | cut -c1-64)
  printf "%s %s %s\n" "$s" "${d##*/}" "$x"
done; done
exit 0'
R_PREP="$(pre prep)"'
w=$W/3-rnd-$2 max=$3
p=$('"$PROBE"' "$w")
case $p in no) echo none; exit 0 ;; yes) ;; *) echo infra; exit 0 ;; esac
sz=$($RUN du -sb -- "$w") || exit 9
sz=${sz%%[!0-9]*}
[ -n "$sz" ] || exit 9
if [ "$sz" -gt "$max" ]; then echo big; else echo ok; fi'
R_LOG="$(pre log)"'
f=$Q/$1/3-rnd-$2/job.log
if [ -L "$f" ] || { [ -e "$f" ] && [ ! -f "$f" ]; }; then exit 4; fi
[ -e "$f" ] || exit 0
tail -c 52428800 "$f" || exit 5
exit 0'
R_WORK="$(pre work)"'
exec $RUN tar -C "$W/3-rnd-$2" -cf - .'
R_FINAL="$(pre final)"'
set -e
n=3-rnd-$2 t=$Q/$1/3-rnd-$2
p=$('"$PROBE"' "$W/$n")
case $p in
  yes) a=$A/$n; e=$('"$PROBE"' "$a")
       case $e in no) ;; yes) a=$a.$(date +%s) ;; *) exit 9 ;; esac
       $RUN mkdir -p -- "$A"; $RUN mv -T -- "$W/$n" "$a" ;;
  no) ;;
  *) exit 9 ;;
esac
c=$Q/collected/$n; if [ -e "$c" ]; then c=$c.$(date +%s); fi
mkdir -p -- "$Q/collected"; mv -T -- "$t" "$c"'

mkdir -p -- "$STATE" || die "cannot create state dir"
stage=$(mktemp -d "${TMPDIR:-/tmp}/v100-sync.XXXXXX")
trap 'chmod -R u+rwX "$stage" 2>/dev/null; rm -rf "$stage"' EXIT

# tar_safe FILE: 0 if the archive lists only regular files and dirs, no absolute or .. paths; else 1 with TWHY set.
# One check for both directions (agent job -> GPU host, GPU host result -> agent spool).
tar_safe() {
  local names types
  names=$(tar -tf "$1") && types=$(tar -tvf "$1" | cut -c1) || { TWHY="unreadable archive"; return 1; }
  if grep -qE '(^|/)\.\.(/|$)|^/' <<<"$names"; then TWHY="unsafe path"; return 1; fi
  if grep -qv '^[-d]$' <<<"$types"; then TWHY="symlink, device or fifo"; return 1; fi
}

# reject NAME WHY: move the spool entry to failed/ with a REASON file (all as the public agent)
reject() {
  local name=$1 why=$2 src=$SPOOL/ready/$1 dest=$SPOOL/failed/$1
  if pub test -e "$dest"; then dest=$dest.$(date +%s); fi
  {
    if pub test -d "$src" && ! pub test -L "$src"; then pub mv -T -- "$src" "$dest"
    else pub mkdir -- "$dest" && pub mv -- "$src" "$dest/entry"; fi &&
    printf '%s\n' "$why" | pub tee -- "$dest/REASON" >/dev/null
  } || { log "reject of $(printf %q "$name") failed"; return 0; }
  log "rejected $(printf %q "$name"): $why"
}

# aside NAME: move the spool entry out of ready/ so it is never submitted twice
aside() {
  local a=$SPOOL/ready/.submitted-$1
  if pub test -e "$a"; then a=$a.$(date +%s); fi
  pub mv -T -- "$SPOOL/ready/$1" "$a" || log "WARN could not move $1 aside"
}

J=
submit_job() {
  local name=$1 d bad sz rc=0 sha
  [[ $name =~ $NAME_RE ]] || { reject "$name" "name must match $NAME_RE"; return 0; }
  J=$(mktemp -d "$stage/j.XXXXXX") || return 1
  d=$J/x/$name; mkdir "$J/x" || return 1
  # copy out as the agent into the operator-owned stage; from here on only the stage is trusted-for-checks
  pub tar -C "$SPOOL/ready" -cf - -- "$name" | head -c $((CAPB + 1)) >"$J/in.tar" || rc=$?
  if [ "$(stat -c %s "$J/in.tar")" -gt "$CAPB" ]; then reject "$name" "job larger than 50 MB"; return 0; fi
  [ "$rc" = 0 ] || { fail "copy of $name failed (rc $rc), retry next tick"; return 0; }
  # inspect the archive before extracting: no traversal, and only regular files/dirs (no links, devices, fifos)
  tar_safe "$J/in.tar" || { reject "$name" "$TWHY in job"; return 0; }
  tar -C "$J/x" --no-same-owner --no-same-permissions -xf "$J/in.tar" || { reject "$name" "extract failed"; return 0; }
  chmod -R u+rwX "$J/x"
  # validate the STAGED copy
  bad=$(find "$d" ! -type f ! -type d -print -quit) || true
  if [ -n "$bad" ]; then reject "$name" "symlink, device or fifo in job"; return 0; fi
  [ -d "$d" ] || { reject "$name" "not a directory"; return 0; }
  [ -f "$d/run.sh" ] || { reject "$name" "run.sh missing"; return 0; }
  # the submit stamp is ours: a job shipping that name (a dir would fail the stamp write on every tick) is refused
  if [ -e "$d/.v100-submit-sha" ] || [ -L "$d/.v100-submit-sha" ]; then reject "$name" "reserved name .v100-submit-sha in job"; return 0; fi
  sz=$(du -sb -- "$d" | cut -f1) || { reject "$name" "size check failed"; return 0; }
  if [ "$sz" -gt "$MAXB" ]; then reject "$name" "job larger than 50 MB"; return 0; fi
  # the shipped bytes are the staged tar; its sha256 is the job's content id
  tar --sort=name --owner=0 --group=0 --numeric-owner -C "$d" -cf "$J/out.tar" . || { fail "stage tar of $name failed"; return 0; }
  sha=$(sha256sum "$J/out.tar") || { fail "sha of $name failed"; return 0; }
  sha=${sha%% *}
  rc=0; rsh "$R_DUP" "$name" "$sha" </dev/null || rc=$?
  case $rc in
    0) ;;
    1) reject "$name" "duplicate: 3-rnd-$name already exists on the GPU host"; return 0 ;;
    3) aside "$name"; log "$name already submitted (same content), moved aside"; return 0 ;;
    *) fail "remote check of $name failed (rc $rc), retry next tick"; return 0 ;;
  esac
  if ! rsh "$R_SUBMIT" "$name" "$sha" "$TOKEN_STUB" <"$J/out.tar"; then fail "remote submit of $name failed, retry next tick"; return 0; fi
  aside "$name"
  log "submitted $name as 3-rnd-$name"
}
submit_one() {
  local rc=0
  J=
  submit_job "$1" || rc=$?
  if [ -n "$J" ]; then chmod -R u+rwX "$J" 2>/dev/null; rm -rf "$J"; fi
  return $rc
}

# wipe PATH: best-effort delete as the agent. A partial extract can leave 0500 dirs that rm cannot enter, so chmod first.
wipe() { pub chmod -R u+rwX -- "$1" 2>/dev/null || true; pub rm -rf -- "$1"; }
# bump: count one failed attempt in collect's att/sf (bash dynamic scope); nonzero if the counter cannot be persisted
bump() { att=$((att + 1)); printf %s "$att" >"$sf"; }
# ibump: same for the separate infra-fault counter ($sf.infra), which gates when infra faults start counting as job faults
ibump() {
  icnt=0; [ ! -r "$sf.infra" ] || icnt=$(<"$sf.infra"); [[ $icnt =~ ^[0-9]+$ ]] || icnt=0
  icnt=$((icnt + 1)); printf %s "$icnt" >"$sf.infra"
}

# collect STATE NAME SHA: remote done|failed/3-rnd-NAME -> spool STATE/NAME/{job.log,work/} (via a hidden temp dir +
# rename), then retire the remote copies. SHA (the token's) is written into the marker: a dest whose marker holds
# another sha is some other job's, so we take the next .N. A delivered result is only retired, never redelivered.
# Failures are counted in $STATE (never in the agent's spool): attempt 3 falls back to job.log only, attempt 10
# gives up on the log too (empty job.log) and retires.
collect() {
  local s=$1 name=$2 jsha=$3 tmpd=$SPOOL/$1/.dest-tmp-$2.$$ sf=$STATE/$1.$2 dest= delivered= cand i mode wf= inf= notes= cnt rc prc att=0 icnt=0
  [[ $jsha =~ ^[0-9a-f]{64}$ ]] || jsha=nosha-$(date +%s%N)-$$   # unique: two sha-less jobs never share a marker
  for i in "" .2 .3 .4 .5 .6 .7 .8 .9; do
    cand=$SPOOL/$s/$name$i
    if ! pub test -e "$cand"; then dest=$cand; break; fi
    if [ "$(pub cat -- "$cand/$MARK" 2>/dev/null)" = "$jsha" ]; then dest=$cand; delivered=1; break; fi
  done
  [ -n "$dest" ] || { fail "no free result name for $name"; return 1; }
  if [ -z "$delivered" ]; then
    if [ -r "$sf" ]; then att=$(<"$sf"); fi
    [[ $att =~ ^[0-9]+$ ]] || att=0
    # sweep dead earlier attempts; each attempt has its own dir, so one stuck dir can never wedge the next tick
    pub find "$SPOOL/$s" -mindepth 1 -maxdepth 1 \( -name ".dest-tmp-$name" -o -name ".dest-tmp-$name.*" \) \
      -exec chmod -R u+rwX {} + -exec rm -rf {} + 2>/dev/null || true
    pub mkdir -- "$tmpd" || { fail "cannot create result dir for $name"; return 1; }
    if [ "$att" -ge "$WORKTRIES" ]; then notes="work collect failed ${WORKTRIES}x: only job.log returned"
    else
      prc=0; mode=$(rsh "$R_PREP" "$s" "$name" "$OUTMAX" </dev/null) || prc=$?
      # an unreadable probe (sudo/ssh down) is the infrastructure's fault, not the job's: retry, never count it
      if [ "$mode" = infra ] || [ "$prc" = 255 ]; then inf="remote probe failed (rc $prc, '$mode')"; mode=none; fi
      case $mode in
        none) ;;
        big) notes="work dir over 200 MB: only job.log returned" ;;
        ok) rc=0; rsh "$R_WORK" "$s" "$name" </dev/null | head -c $((STREAMCAP + 1)) >"$stage/res.tar" || rc=$?
            if [ "$(stat -c %s "$stage/res.tar")" -gt "$STREAMCAP" ]; then notes="work stream over the size cap: only job.log returned"
            elif [ "$rc" = 255 ]; then inf="work stream lost (ssh rc 255)"
            elif [ "$rc" != 0 ]; then wf="work stream failed (rc $rc)"
            elif ! cnt=$(tar -tf "$stage/res.tar" | wc -l); then wf="work stream unreadable"
            elif [ "$cnt" -gt "$MAXFILES" ]; then notes="work dir over $MAXFILES files: only job.log returned"
            elif ! tar_safe "$stage/res.tar"; then notes="work stream rejected ($TWHY): only job.log returned"
            elif ! { pub mkdir -- "$tmpd/work" && pub tar -C "$tmpd/work" --no-same-owner --no-same-permissions -xf - <"$stage/res.tar"; }; then wf="work extract failed"; fi
            unlink "$stage/res.tar" ;;
        *) wf="size check gave '$mode'" ;;
      esac
    fi
    if [ -n "$inf" ]; then
      # uncounted, but not forever: a job can induce an "infra" fault (e.g. kill its own tar), so past INFRATRIES the next one counts as the job's
      ibump || { wipe "$tmpd"; fail "collect of $name: cannot write infra counter $sf.infra"; return 1; }
      if [ "$icnt" -le "$INFRATRIES" ]; then wipe "$tmpd"; fail "collect of $name failed ($inf), infra retry $icnt/$INFRATRIES, not counted"; return 1; fi
      wf="$inf; infra retries exhausted"
    fi
    if [ -n "$wf" ]; then
      bump || { wipe "$tmpd"; fail "collect of $name: cannot write attempt counter $sf"; return 1; }
      wipe "$tmpd/work"
      if [ "$att" -lt "$WORKTRIES" ]; then wipe "$tmpd"; fail "collect of $name failed ($wf), attempt $att/$WORKTRIES, retry next tick"; return 1; fi
      notes="work collect failed ${WORKTRIES}x: only job.log returned"
      fail "collect of $name: work failed $WORKTRIES times ($wf), delivering job.log only"
    fi
    rc=0; rsh "$R_LOG" "$s" "$name" </dev/null >"$stage/log" || rc=$?
    case $rc in
      0) ;;
      4) : >"$stage/log"; notes+="${notes:+$'\n'}job.log is not a regular file: empty job.log returned" ;;
      *) bump || { wipe "$tmpd"; fail "collect of $name: cannot write attempt counter $sf"; return 1; }
         if [ "$att" -lt "$LOGTRIES" ]; then wipe "$tmpd"; fail "collect of $name failed (log), attempt $att/$LOGTRIES, retry next tick"; return 1; fi
         : >"$stage/log"; notes+="${notes:+$'\n'}job.log collect failed ${LOGTRIES}x: empty job.log returned"
         fail "collect of $name: log failed $LOGTRIES times, delivering an empty job.log and retiring" ;;
    esac
    if { [ -z "$notes" ] || printf '%s\n' "$notes" | pub tee -- "$tmpd/TRUNCATED" >/dev/null; } &&
       pub tee -- "$tmpd/job.log" >/dev/null <"$stage/log" &&
       printf %s "$jsha" | pub tee -- "$tmpd/$MARK" >/dev/null && pub mv -T -- "$tmpd" "$dest"; then :
    else wipe "$tmpd"; fail "collect of $name failed (finish), retry next tick"; return 1; fi
  fi
  rsh "$R_FINAL" "$s" "$name" </dev/null || { fail "remote retire of $name failed, retry next tick"; return 1; }
  rm -f -- "$sf" "$sf.infra"
  log "collected $s/$name"
}

pub mkdir -p -- "$SPOOL/ready" "$SPOOL/done" "$SPOOL/failed" || die "cannot prepare spool"

pub find "$SPOOL/ready" -mindepth 1 -maxdepth 1 ! -name '.*' -printf '%f\0' >"$stage/names" || die "cannot list spool"
while IFS= read -r -d '' -u 3 name; do submit_one "$name" || fail "submit of $(printf %q "$name") aborted"; done 3<"$stage/names"

rsh "$R_LIST" </dev/null >"$stage/results" || { fail "remote result list failed"; exit 1; }
while read -r -u 3 s n sha; do
  [[ $s == done || $s == failed ]] && [[ $n =~ ^3-rnd-([a-z0-9][a-z0-9-]{0,40})$ ]] || { log "ignoring result row"; continue; }
  collect "$s" "${BASH_REMATCH[1]}" "$sha" || true
done 3<"$stage/results"
exit $errs
