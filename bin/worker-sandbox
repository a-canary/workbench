#!/usr/bin/env bash
# worker-sandbox — run a pi worker agent jailed to one git worktree.
#
#   worker-sandbox --worktree DIR --lane private|public --task FILE \
#                  [--tools read,edit,write,bash] [--timeout 600] [--exec CMD...]
#
# Jail (bwrap): own user/pid/net/ipc/uts/cgroup namespaces, no capabilities,
# cleared env, read-only /usr, a handful of /etc files, tmpfs $HOME and /tmp.
# The ONLY writable host path is the worktree (at /work); its .git is masked so
# the worker cannot rewrite history or reach the main repo — the harness commits.
# The ONLY network path is a unix-socket relay to exactly one LLM endpoint:
#   private lane -> local V100 laneproxy (never leaves the box)
#   public  lane -> 9router Worker combo (cloud; refused unless repo is PUBLIC)
# --exec runs CMD in the jail instead of pi (used by worker-sandbox-test).
set -euo pipefail

die() { echo "worker-sandbox: $*" >&2; exit 2; }
here=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

wt= lane= task= tools=read,edit,write,bash tmo=600 exec_cmd=()
while [ $# -gt 0 ]; do
  case $1 in
    --worktree) wt=$2; shift 2 ;;
    --lane) lane=$2; shift 2 ;;
    --task) task=$2; shift 2 ;;
    --tools) tools=$2; shift 2 ;;
    --timeout) tmo=$2; shift 2 ;;
    --exec) shift; exec_cmd=("$@"); break ;;
    *) die "unknown arg $1" ;;
  esac
done
[ -d "$wt" ] || die "--worktree DIR required"
wt=$(readlink -f "$wt")
[ ${#exec_cmd[@]} -gt 0 ] || [ -f "$task" ] || die "--task FILE required"
[[ $tools =~ ^[a-z,]+$ ]] || die "bad --tools"
[[ $tmo =~ ^[0-9]+$ ]] || die "bad --timeout"

case $lane in
  private)
    port=${WORKER_PRIVATE_PORT:-8099} model=${WORKER_PRIVATE_MODEL:-queue} key=none ;;
  public)
    # fail closed: only a repo GitHub reports PUBLIC may send code to a cloud model
    vis=$(cd "$wt" && gh repo view --json visibility -q .visibility 2>/dev/null) || vis=
    [ "$vis" = PUBLIC ] || die "public lane refused: repo visibility '${vis:-unknown}' (need PUBLIC)"
    port=${WORKER_PUBLIC_PORT:-20128} model=${WORKER_PUBLIC_MODEL:-Worker}
    # ponytail: key is visible inside the jail (pi needs it); it can only reach 9router
    # through the relay, and the harness greps the diff for it before committing.
    key=${WORKER_PUBLIC_KEY:-$(pass show "${WORKER_PUBLIC_PASS:-api/9router}" | head -1)} ;;
  *) die "--lane private|public required" ;;
esac

tmp=$(mktemp -d "${TMPDIR:-/tmp}/worker-sandbox.XXXXXX")
relay_pid=
cleanup() { [ -n "$relay_pid" ] && kill "$relay_pid" 2>/dev/null; rm -rf "$tmp"; }
trap cleanup EXIT

# host side of the only door: unix socket -> 127.0.0.1:$port
python3 "$here/relay.py" unix2tcp "$tmp/ep.sock" "127.0.0.1:$port" &
relay_pid=$!
for _ in $(seq 50); do [ -S "$tmp/ep.sock" ] && break; sleep 0.1; done
[ -S "$tmp/ep.sock" ] || die "relay failed to start"

mkdir -p "$tmp/agent"
umask 077
jq -n --arg port "$port" --arg model "$model" --arg key "$key" '{providers:{w:{
  baseUrl:"http://127.0.0.1:\($port)/v1", api:"openai-completions", apiKey:$key,
  compat:{supportsDeveloperRole:false, sendSessionAffinityHeaders:true},
  models:[{id:$model, name:$model, input:["text"], maxTokens:16384}]}}}' > "$tmp/agent/models.json"
echo '{}' > "$tmp/agent/settings.json"
cp "$here/relay.py" "$tmp/relay.py"

args=(--unshare-all --unshare-user --die-with-parent --new-session --clearenv --disable-userns --cap-drop ALL
  --ro-bind /usr /usr --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run
  --tmpfs /home --dir /home/worker --chdir /work)
for l in bin lib lib64 sbin; do
  if [ -L "/$l" ]; then args+=(--symlink "$(readlink "/$l")" "/$l")
  elif [ -d "/$l" ]; then args+=(--ro-bind "/$l" "/$l"); fi
done
for e in ld.so.cache ssl ca-certificates alternatives passwd group nsswitch.conf hosts localtime; do
  [ -e "/etc/$e" ] && args+=(--ro-bind "/etc/$e" "/etc/$e")
done
# runtimes that live outside /usr (e.g. bun under $HOME) get bound read-only at /opt/<name>
path=/usr/local/bin:/usr/bin:/bin
for b in pi node bun; do
  p=$(command -v "$b" 2>/dev/null) || continue
  case $p in /usr/*) path=$path:${p%/*}; continue ;; esac  # already bound; just needs PATH
  p=$(readlink -f "$p"); case $p in /usr/*) continue ;; esac
  args+=(--ro-bind "$p" "/opt/$b/$b"); path=/opt/$b:$path
done
args+=(--bind "$wt" /work)
if [ -d "$wt/.git" ]; then args+=(--tmpfs /work/.git)
elif [ -e "$wt/.git" ]; then args+=(--ro-bind /dev/null /work/.git); fi
# No network in the jail, so a fresh worktree can't install deps: lend the host repo's, read-only.
[ -n "${WORKER_DEPS:-}" ] && [ -d "$WORKER_DEPS" ] && [ ! -e "$wt/node_modules" ] && args+=(--ro-bind "$(readlink -f "$WORKER_DEPS")" /work/node_modules)
args+=(--bind "$tmp/agent" /home/worker/.pi/agent
  --ro-bind "$tmp/relay.py" /run/relay.py --bind "$tmp/ep.sock" /run/ep.sock
  --setenv HOME /home/worker --setenv PATH "$path" --setenv TERM dumb
  --setenv LANG C.UTF-8 --setenv USER worker --setenv WORKER_PORT "$port"
  --remount-ro /)  # root tmpfs (incl. /etc parent of the file binds) read-only; submounts keep their flags

if [ ${#exec_cmd[@]} -eq 0 ]; then
  exec_cmd=(pi -p --no-session --no-extensions --no-mcp --no-skills --no-prompt-templates
    --no-themes --tools "$tools" --provider w --model "w/$model" "$(cat "$task")")
fi

# jail side of the door: 127.0.0.1:$port -> /run/ep.sock, then the payload
inner='python3 /run/relay.py tcp2unix 127.0.0.1:$WORKER_PORT /run/ep.sock &
for _ in $(seq 50); do python3 -c "import socket,os;socket.create_connection((\"127.0.0.1\",int(os.environ[\"WORKER_PORT\"])),1)" 2>/dev/null && break; sleep 0.1; done
"$@"; rc=$?; kill %1 2>/dev/null; exit $rc'

# ponytail: cgroup caps via systemd user scope when available; plain run otherwise
lim=()
if systemd-run --user --scope -q true 2>/dev/null; then
  lim=(systemd-run --user --scope -q -p TasksMax=512 -p MemoryMax=8G --)
fi
set +e
"${lim[@]}" timeout -k 10 "$tmo" bwrap "${args[@]}" /bin/sh -c "$inner" sh "${exec_cmd[@]}"
rc=$?
[ $rc -eq 124 ] && echo "worker-sandbox: timeout after ${tmo}s" >&2
exit $rc
