#!/usr/bin/env bash
# worker-review — default reviewer for worker-task --review. stdin: task, blank line, staged diff.
# stdout: first line PASS, or FAIL: <reason>. Non-zero exit on any transport/parse failure, a hang or an empty reply.
# ponytail: an LLM verdict on worker-controlled text is a second opinion, not the gate; the RED->GREEN test is.
set -euo pipefail
sys='You review a worker'"'"'s diff against its task. Reply PASS if the diff does only what the task asks; otherwise reply FAIL: <reason>. First line is the verdict.'
# stdin streams through jq -Rs and curl @-: no argv copy of the diff, so no ARG_MAX ceiling.
# Streamed: a non-streamed call gives the lane no first byte until the whole reply is done, and has hung.
out=$(jq -Rs --arg m "${WORKER_PRIVATE_MODEL:-queue}" --arg s "$sys" \
  '{model:$m,stream:true,messages:[{role:"system",content:$s},{role:"user",content:.}]}' |
  curl -sSN --fail --noproxy '*' --max-time "${WORKER_REVIEW_TIMEOUT:-300}" -H 'Content-Type: application/json' --data-binary @- \
    "http://127.0.0.1:${WORKER_PRIVATE_PORT:-8099}/v1/chat/completions" |
  sed -n 's/^data: //p' | grep -vx '\[DONE\]' | jq -rj '.choices[0].delta.content // empty')
[ -n "$out" ] || { echo "worker-review: empty reply" >&2; exit 1; }
printf '%s\n' "$out"
